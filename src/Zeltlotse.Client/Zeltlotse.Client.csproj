<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Die Oberfläche ist deutsch: Datumsangaben brauchen echte
         Kulturdaten, nicht die invariante Kultur. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeltlotse.Core.Organisationen.Contracts\Zeltlotse.Core.Organisationen.Contracts.csproj" />
    <ProjectReference Include="..\Zeltlotse.Core.Freizeiten.Contracts\Zeltlotse.Core.Freizeiten.Contracts.csproj" />
    <ProjectReference Include="..\Zeltlotse.Core.Konten.Contracts\Zeltlotse.Core.Konten.Contracts.csproj" />
  </ItemGroup>

</Project>
