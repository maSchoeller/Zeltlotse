<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(HauptLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(HauptLayout)">
            <div class="zl-seite">
                <h1>Diese Seite gibt es nicht.</h1>
                <p class="zl-gedaempft">Vielleicht hilft der Weg zur <a href="/">Startseite</a>.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
