@page "/einladung/{Token}"
@layout HauptLayout
@inject Sitzung Sitzung
@inject ZeltlotseApi Api
@inject NavigationManager Navigation

<PageTitle>Einladung · Zeltlotse</PageTitle>

<div class="zl-mitte">
    <div class="zl-karte">
        <div class="zl-marke">Zeltlotse</div>

        @if (!_geprueft)
        {
            <p class="zl-gedaempft">Einen Moment …</p>
        }
        else if (_vorschau is null)
        {
            <h1 class="zl-titel">Diese Einladung gilt nicht mehr.</h1>
            <p class="zl-gedaempft">
                Sie ist abgelaufen oder wurde bereits benutzt. Bitte dich neu einladen — Links
                funktionieren genau einmal.
            </p>
            <a class="zl-knopf zl-knopf--sekundaer" href="/anmelden">Zur Anmeldung</a>
        }
        else
        {
            <h1 class="zl-titel">Willkommen bei @_vorschau.OrganisationName</h1>
            <p class="zl-gedaempft">
                Du bist als <strong>@_vorschau.EMail</strong> eingeladen. Vergib ein Kennwort —
                danach bist du angemeldet.
            </p>

            @if (_fehler is not null)
            {
                <div class="zl-meldung zl-meldung--fehler">@_fehler</div>
            }

            <EditForm Model="@this" OnValidSubmit="Absenden">
                <div class="zl-feld">
                    <label for="kennwort">Kennwort</label>
                    <input id="kennwort" type="password" autocomplete="new-password" @bind="_kennwort" />
                    <div class="zl-hilfe">Mindestens 10 Zeichen, mit Groß-, Kleinbuchstaben und Ziffer.</div>
                </div>

                <div class="zl-feld">
                    <label for="wiederholung">Kennwort wiederholen</label>
                    <input id="wiederholung" type="password" autocomplete="new-password"
                           @bind="_wiederholung" />
                </div>

                <button type="submit" class="zl-knopf zl-knopf--primaer" disabled="@_laeuft"
                        style="width:100%">
                    @(_laeuft ? "Einen Moment …" : "Loslegen")
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private EinladungVorschauDto? _vorschau;
    private string _kennwort = string.Empty;
    private string _wiederholung = string.Empty;
    private string? _fehler;
    private bool _laeuft;
    private bool _geprueft;

    protected override async Task OnInitializedAsync()
    {
        var ergebnis = await Api.EinladungVorschauAsync(Token);
        _vorschau = ergebnis.Wert;
        _geprueft = true;
    }

    private async Task Absenden()
    {
        if (_kennwort != _wiederholung)
        {
            _fehler = "Die beiden Kennwörter stimmen nicht überein.";
            return;
        }

        _laeuft = true;
        _fehler = null;

        _fehler = await Sitzung.EinladungEinloesenAsync(Token, _kennwort);

        _laeuft = false;

        if (_fehler is null)
        {
            Navigation.NavigateTo("/");
        }
    }
}
