@page "/freizeiten/{FreizeitId:guid}/nachweise"
@page "/organisationen/{OrgId:guid}/nachweise"
@using Zeltlotse.Api.Contracts.Personen
@inject PersonenApiClient Personen
@inject NavigationManager Navigation
@* Nachweise prüfen (FR-10, AD-9): eine Seite für die Leitung (Freizeit) und den Org-Admin (Organisation). Je Person Status der
   jüngsten Einsicht (auch „Freigabe abgelaufen am …“); „Einsicht anfragen“, wenn keine offen ist; „Prüfen“, wenn die Einsicht
   freigegeben und an die eigene Person gebunden oder von ihr übernehmbar ist (übernimmt die Prüfung und öffnet die Einsicht).
   403/404 → nicht verfügbar. *@
<PageTitle>Nachweise prüfen – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else
{
    <h1>Nachweise prüfen</h1>
    <p><a href="@Zurueck">@ZurueckText</a></p>

    @if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
    }
    @if (_meldung is not null)
    {
        <Meldung Titel="@(_meldungFehler ? "Fehler" : "Gespeichert")" Art="@(_meldungFehler ? MeldungArt.Fehler : MeldungArt.Erfolg)">
            <p>@_meldung</p>
        </Meldung>
    }

    @if (_liste is null)
    {
        @if (!_aktionFehler)
        {
            <Ladezustand />
        }
    }
    else if (_liste.Count == 0)
    {
        <LeerZustand Satz="Noch niemand im Team." />
    }
    else
    {
        <Datentabelle TZeile="PruefPerson" Beschriftung="Nachweise prüfen" Spalten="Spalten" Zeilen="_liste" />
    }
}

@code {
    private List<PruefPerson>? _liste;
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _uebertraegt;
    private string? _meldung;
    private bool _meldungFehler;

    [Parameter] public Guid FreizeitId { get; set; }

    [Parameter] public Guid OrgId { get; set; }

    private bool InFreizeit => FreizeitId != Guid.Empty;

    private PruefOrt Ort => InFreizeit ? PruefOrt.Freizeit(FreizeitId) : PruefOrt.Organisation(OrgId);

    private string Zurueck => InFreizeit ? $"freizeiten/{FreizeitId}" : $"organisationen/{OrgId}";

    private string ZurueckText => InFreizeit ? "Zurück zur Freizeit" : "Zurück zur Organisation";

    private IReadOnlyList<Spalte<PruefPerson>> Spalten =>
    [
        new("Name", p => @<text>@Anzeige.Name(p.Vorname, p.Nachname)</text>),
        new("Status", p => @<text>@StatusText(p.Einsicht)</text>),
        new("Aktion", p => @<text>
            @if (p.Anfragbar)
            {
                <Knopf Art="KnopfArt.Outline" Deaktiviert="@_uebertraegt" @onclick="@(() => AnfragenAsync(p))">Einsicht anfragen</Knopf>
            }
            @if (p.Einsicht is { Pruefbar: true, Status: EinsichtStatus.Freigegeben } einsicht)
            {
                <Knopf Deaktiviert="@_uebertraegt" Ansichtswechsel="true" @onclick="@(() => PruefenAsync(einsicht.Id))">Prüfen</Knopf>
            }
        </text>),
    ];

    private static string StatusText(PruefEinsicht? einsicht) => einsicht switch
    {
        null => "Noch nicht angefragt",
        { Status: EinsichtStatus.Abgeschlossen, AbgeschlossenAm: { } am } => $"Geprüft am {Anzeige.Datum(am)}",
        { Status: EinsichtStatus.Freigegeben, FreigegebenBis: { } bis } => $"Freigegeben bis {Anzeige.Datum(bis)}",
        { Status: EinsichtStatus.Abgelaufen, FreigegebenBis: { } abgelaufen } => $"Freigabe abgelaufen am {Anzeige.Datum(abgelaufen)}",
        _ => $"Angefragt am {Anzeige.Datum(einsicht.AngefragtAm)}",
    };

    protected override async Task OnParametersSetAsync()
    {
        _liste = null;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _meldung = null;
        try
        {
            await NeuLadenAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (offline, 5xx) die Meldung statt „Wird geladen …“.
            _aktionFehler = true;
        }
    }

    private async Task NeuLadenAsync()
    {
        _liste = await Personen.PruefListeLadenAsync(Ort);
        _nichtVerfuegbar = _liste is null;
    }

    private async Task AnfragenAsync(PruefPerson person)
    {
        _uebertraegt = true;
        _aktionFehler = false;
        _meldung = null;
        try
        {
            var einsicht = await Personen.EinsichtAnfragenAsync(Ort, person.PersonId);
            (_meldung, _meldungFehler) = einsicht is null
                ? ("Die Einsicht ließ sich nicht anfragen.", true)
                : ("Die Einsicht ist angefragt.", false);
            await NeuLadenAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }

    private async Task PruefenAsync(Guid einsichtId)
    {
        _uebertraegt = true;
        _aktionFehler = false;
        _meldung = null;
        try
        {
            switch (await Personen.PruefenAsync(Ort, einsichtId))
            {
                case PruefErgebnis.Gebunden:
                    Navigation.NavigateTo($"{Zurueck}/nachweise/{einsichtId}");
                    return;
                case PruefErgebnis.NichtFreigegeben:
                    (_meldung, _meldungFehler) = ("Die Einsicht ist nicht mehr freigegeben.", true);
                    break;
                default:
                    (_meldung, _meldungFehler) = ("Eine andere Person prüft diese Nachweise schon.", true);
                    break;
            }

            await NeuLadenAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
