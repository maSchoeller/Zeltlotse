@page "/freizeiten/{FreizeitId:guid}/kanaele"
@implements IAsyncDisposable
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Api.Contracts.Kanaele
@using Zeltlotse.Ui.Kontext
@inject FreizeitKontextDienst Kontext
@inject KanaeleApiClient KanaeleApi
@inject FreizeitenApiClient Freizeiten
@inject IBrowser Browser
@inject NavigationManager Navigation
@* Kanäle „Team“ und „Alle“ (CAP-35, FR-61, Story 6-1; EXPERIENCE.md → Kanal-Nachrichten) für Leitung und Team, erreicht über den Knopf „Kanäle“ auf der
   Startseite. Dachzeile „Kanäle“, Überschrift der Kanal, darunter die Reiter „Nachrichten · Ansagen-Zettel · Besprechung“ (Story 6-3) und die Segmente „Team / Alle“ (die Wahl steht in der Adresse, ?kanal=alle). Die Nachrichten
   stehen älteste zuerst, die neueste unten; die Seite öffnet am Ende. Darüber die Card „Benachrichtigungen“, darunter das Eingabefeld: In „Team“ geht „Senden“ direkt hinaus, in „Alle“ klappt es
   zuerst die Inline-Bestätigung „An N Personen senden?“ auf („Ja, senden“ / „Nein“). In der Card „Benachrichtigungen“: Die Erlaubnis für Push fragt die Seite
   erst nach einem Tipp auf „Benachrichtigungen einschalten“; ohne Push-Möglichkeit steht der passende Hinweis (iPhone ohne Home-Bildschirm, abgelehnt,
   Browser ohne Push), die Kanäle bleiben lesbar und beschreibbar. Hat das Gerät schon ein Abo, erneuert die Seite es still für diese Freizeit. Geht ein
   Push ein, lädt der Kanal neu. Story 6-4: Die Card ist der gemeinsame Baustein PushCard (auch für den Teilnehmer-Zugang). Keine Zähler. In der Phase „gelaufen“ nur lesbar, ohne Eingabefeld und ohne Benachrichtigungen. Kontext oder Kanal nicht
   verfügbar → „Diese Seite ist nicht verfügbar.“. Namen kommen aus Freizeit und Personenliste (AD-2). *@
<PageTitle>Kanäle – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else
{
    <Dachzeile>Kanäle</Dachzeile>
    <h1>@(Gewaehlt == Kanal.Alle ? "Alle" : "Team")</h1>
    <KanaeleReiter FreizeitId="FreizeitId" Aktiv="nachrichten" />
    <Segmente Legende="Kanal" Optionen="KanaeleTexte.KanalOptionen" Wert="@KanalFelder.InRoute(Gewaehlt)" Gewaehlt="Wechseln" />

    @if (_meldung is not null)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@_meldung</p>
        </Meldung>
    }

    @if (_ansicht is null || _kontext is null)
    {
        @if (_meldung is null)
        {
            <Ladezustand />
        }
    }
    else
    {
        @if (Abgeschlossen)
        {
            <Meldung Titel="Hinweis">
                <p>@KanaeleTexte.AbgeschlossenText</p>
            </Meldung>
        }

        @if (!Abgeschlossen)
        {
            <PushCard Ziel="@FreizeitId.ToString()" SchluesselLaden="@(() => KanaeleApi.SchluesselLadenAsync(FreizeitId))"
                      AboSpeichern="@(abo => KanaeleApi.AboSpeichernAsync(FreizeitId, abo))" Abmelden="@(endpunkt => KanaeleApi.AbmeldenAsync(FreizeitId, endpunkt))" />
        }

        <KanalNachrichten Nachrichten="@([.. _ansicht.Nachrichten.Select(n => KanaeleTexte.Eintrag(n, _personen))])" />

        @if (!Abgeschlossen)
        {
            <Formular Absenden="@(() => Gewaehlt == Kanal.Team ? SendenAsync(bestaetigt: null) : Task.CompletedTask)">
                <Feld Label="Nachricht" Id="kanal-text" Mehrzeilig="true" Zeilen="3" Wert="@_text" Fehler="@_textFehler" Deaktiviert="@_sendet"
                      Hinweis="@($"Höchstens {KanalFelder.TextMaximaleLaenge} Zeichen")" @oninput="@(e => _text = e.Value?.ToString())" />
                @if (Gewaehlt == Kanal.Alle)
                {
                    <InlineBestaetigung AusloeserText="Senden" Satz="@KanaeleTexte.BestaetigungSatz(_ansicht.PersonenAlle)" JaText="Ja, senden"
                                        Bestaetigt="@(() => SendenAsync(bestaetigt: true))" />
                }
                else
                {
                    <Knopf @onclick="@(() => SendenAsync(bestaetigt: null))">Senden</Knopf>
                }
            </Formular>
        }
    }
    <p id="kanal-ende"><a href="@($"freizeiten/{FreizeitId}")">Zurück zur Freizeit</a></p>
}

@code {
    private FreizeitKontext? _kontext;
    private KanalAnsicht? _ansicht;
    private IReadOnlyDictionary<Guid, (string? Vorname, string? Nachname)> _personen = new Dictionary<Guid, (string?, string?)>();
    private IAsyncDisposable? _pushBeobachtung;
    private bool _nichtVerfuegbar;
    private bool _sendet;
    private bool _ansEnde;
    private string? _meldung;
    private string? _text;
    // Der Kanal, zu dem der Entwurf gehört: Ein Entwurf aus „Team“ darf nach dem Wechsel nicht mit einem Tipp an alle gehen.
    private (Guid Freizeit, Kanal Kanal)? _entwurfFuer;
    private string? _textFehler;

    [Parameter] public Guid FreizeitId { get; set; }

    /// <summary>Der Kanal aus der Adresse: <c>?kanal=alle</c>, sonst „Team“.</summary>
    [SupplyParameterFromQuery(Name = "kanal")] public string? KanalWahl { get; set; }

    private Kanal Gewaehlt => KanalFelder.AusRoute(KanalWahl) ?? Kanal.Team;

    private bool Abgeschlossen => _kontext?.Phase == Phase.Gelaufen;

    protected override async Task OnParametersSetAsync()
    {
        if (_entwurfFuer != (FreizeitId, Gewaehlt))
        {
            _text = null;
            _textFehler = null;
            _entwurfFuer = (FreizeitId, Gewaehlt);
        }

        _ansicht = null;
        _nichtVerfuegbar = false;
        _meldung = null;
        _textFehler = null;
        try
        {
            var kontext = Kontext.LadenAsync(FreizeitId);
            var ansicht = KanaeleApi.LadenAsync(FreizeitId, Gewaehlt);
            var personen = KanaeleTexte.PersonenLadenAsync(Freizeiten, FreizeitId);
            await Task.WhenAll(kontext, ansicht, personen);
            if (kontext.Result is null || ansicht.Result is null)
            {
                _nichtVerfuegbar = true;
                return;
            }

            (_kontext, _ansicht, _personen) = (kontext.Result, ansicht.Result, personen.Result);
            _ansEnde = true;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (offline, 5xx) die Meldung statt „Wird geladen …“.
            _meldung = AnmeldungAbschluss.FehlerText;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pushBeobachtung = await Browser.PushBeobachtenAsync(PushEingegangenAsync);
        }

        if (_ansEnde && _ansicht is not null)
        {
            _ansEnde = false;
            await Browser.AnsEndeScrollenAsync("kanal-ende");
        }
    }

    private void Wechseln(string wert)
    {
        // Der Entwurf gehört zum bisherigen Kanal.
        _text = null;
        _textFehler = null;
        Navigation.NavigateTo(KanaeleTexte.Ziel(FreizeitId, KanalFelder.AusRoute(wert) ?? Kanal.Team));
    }

    private async Task SendenAsync(bool? bestaetigt)
    {
        if (_sendet || _ansicht is null)
        {
            return;
        }

        _sendet = true;
        _textFehler = null;
        _meldung = null;
        try
        {
            var aktion = await KanaeleApi.SendenAsync(FreizeitId, Gewaehlt, new NachrichtNeu(_text, bestaetigt));
            switch (aktion.Ergebnis)
            {
                case KanalAktionErgebnis.Erfolg:
                    _text = "";
                    await LadenAsync();
                    break;
                case KanalAktionErgebnis.Abgeschlossen:
                    _kontext = await Kontext.LadenAsync(FreizeitId) ?? _kontext;
                    _meldung = KanaeleTexte.AbgeschlossenText;
                    break;
                default:
                    _textFehler = aktion.Feldfehler.GetValueOrDefault(KanalFelder.Text)
                                  ?? aktion.Feldfehler.GetValueOrDefault(KanalFelder.Bestaetigt)
                                  ?? KanaeleTexte.NichtGesendetText;
                    break;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _textFehler = KanaeleTexte.NichtGesendetText;
        }
        finally
        {
            _sendet = false;
        }
    }

    /// <summary>Lädt den Kanal neu (nach dem Senden und bei einem eingehenden Push) und scrollt ans Ende.</summary>
    private async Task LadenAsync()
    {
        try
        {
            if (await KanaeleApi.LadenAsync(FreizeitId, Gewaehlt) is { } ansicht)
            {
                _ansicht = ansicht;
                _ansEnde = true;
            }
            else
            {
                _nichtVerfuegbar = true;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
    }

    private async Task PushEingegangenAsync()
    {
        if (_ansicht is null)
        {
            return;
        }

        await LadenAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_pushBeobachtung is not null)
        {
            await _pushBeobachtung.DisposeAsync();
        }
    }
}
