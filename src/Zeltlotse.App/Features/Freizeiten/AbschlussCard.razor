@attribute [NurInteraktiv]
@using Zeltlotse.Api.Contracts.Programm
@inject FreizeitenApiClient Freizeiten
@* Story 3-8 (CAP-27, AD-17): Card „Abschluss“ auf der Startseite in der Nachbereitung, für Leitung und Team. Sie nennt die offenen (nicht
   erledigten) Aufgaben der Freizeit mit Link und verweist auf „Schäden & Verluste“; die Aufgaben lädt die Startseite schon (AD-2, der Client
   setzt zusammen). Scheitert ihr Abruf, entfällt die Liste. Mit „freizeit-einstellungen“ (nur Leitung) steht darunter „Freizeit abschließen“
   als Inline-Bestätigung: ohne offene Aufgaben „Freizeit abschließen? Danach ist sie nur lesbar.“, sonst „2 Aufgaben offen – trotzdem
   abschließen?“. Offene Punkte halten den Abschluss nicht auf. Nach dem Erfolg meldet die Card Abgeschlossen; die Startseite lädt neu. *@
<Card Titel="Abschluss" Id="abschluss">
    <p>Nach dem Abschluss ist die Freizeit nur noch lesbar. Schäden und Verluste werden zu Anschaffungswünschen an die Organisation.</p>
    @if (Aufgaben is not null)
    {
        @if (Offene.Count == 0)
        {
            <p>Alle Aufgaben sind erledigt.</p>
        }
        else
        {
            <p>@(Offene.Count == 1 ? "1 Aufgabe ist noch offen:" : $"{Offene.Count} Aufgaben sind noch offen:")</p>
            <ul>
                @foreach (var aufgabe in Offene)
                {
                    <li @key="aufgabe.Id"><a href="@ProgrammTexte.AufgabeZiel(FreizeitId, aufgabe.Id)">@aufgabe.Titel</a></li>
                }
            </ul>
        }
    }
    <p><a href="@($"freizeiten/{FreizeitId}/schaeden")">Schäden &amp; Verluste</a> vor dem Abschluss durchsehen.</p>
    @if (_fehler is not null)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@_fehler</p>
        </Meldung>
    }
    @if (DarfAbschliessen)
    {
        <InlineBestaetigung AusloeserText="Freizeit abschließen" Satz="@(Aufgaben is null ? AufgabenUnbekannt : Anzeige.AbschlussSatz(Offene.Count))" JaText="Ja, abschließen"
                            Bestaetigt="AbschliessenAsync" />
    }
</Card>

@code {
    /// <summary>Satz der Rückfrage, wenn die Aufgaben nicht geladen werden konnten.</summary>
    public const string AufgabenUnbekannt = "Offene Aufgaben ließen sich nicht laden – trotzdem abschließen?";

    private bool _uebertraegt;
    private string? _fehler;

    [Parameter, EditorRequired] public Guid FreizeitId { get; set; }

    /// <summary>Die Aufgaben der Freizeit; <c>null</c>, wenn ihr Abruf gescheitert ist.</summary>
    [Parameter] public IReadOnlyList<Aufgabe>? Aufgaben { get; set; }

    /// <summary>Mit „freizeit-einstellungen“ (nur Leitung) der Knopf „Freizeit abschließen“.</summary>
    [Parameter] public bool DarfAbschliessen { get; set; }

    /// <summary>Nach einem Abschluss (auch einem, den jemand anderes schon getan hat): Die Startseite lädt neu.</summary>
    [Parameter] public EventCallback Abgeschlossen { get; set; }

    private List<Aufgabe> Offene => [.. (Aufgaben ?? []).Where(a => !a.Erledigt)];

    private async Task AbschliessenAsync()
    {
        // Zweimal ausgelöst, während die erste Anfrage noch läuft: nur einmal senden.
        if (_uebertraegt)
        {
            return;
        }

        _uebertraegt = true;
        _fehler = null;
        try
        {
            switch (await Freizeiten.AbschliessenAsync(FreizeitId))
            {
                case AbschlussErgebnis.Abgeschlossen or AbschlussErgebnis.SchonAbgeschlossen:
                    await Abgeschlossen.InvokeAsync();
                    break;
                case AbschlussErgebnis.ZuFrueh:
                    _fehler = "Abschließen geht erst nach dem letzten Freizeittag.";
                    break;
                default:
                    _fehler = "Die Freizeit ließ sich nicht abschließen.";
                    break;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _fehler = AnmeldungAbschluss.FehlerText;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
