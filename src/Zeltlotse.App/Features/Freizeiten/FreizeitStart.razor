@page "/freizeiten/{FreizeitId:guid}"
@using Zeltlotse.Api.Contracts.Freizeiten
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Api.Contracts.Personen
@using Zeltlotse.Ui.Kontext
@inject FreizeitKontextDienst Kontext
@inject FreizeitenApiClient Freizeiten
@inject PersonenApiClient Personen
@inject SicherheitApiClient SicherheitApi
@inject ProgrammApiClient ProgrammApi
@* Startseite der Freizeit (FR-45, AD-29): Name, Phase, Zeitraum, eigene Rolle aus dem Freizeit-Kontext, die Leitung und bis
   wann die Freizeit Einsicht in Freizeitpässe hat (Freigabefenster). Der Client setzt die Ansicht aus dem Kontext-Endpunkt
   und dem Endpunkt der Freizeit zusammen (AD-2).
   Für die Leitung ist sie das Leitungs-Cockpit (Story 2-6, FR-25, FR-27), zusammengesetzt aus vorhandenen Endpunkten und dem
   Freizeitpass-Stand von Personen:
   - Card „Anmeldungen“ (mit „anmeldungen-bearbeiten“): Balken „Plätze“, je Art eingegangen und bestätigt (ohne Absagen) und der Knopf
     „Anmeldungen“. Scheitert der Abruf, bleibt nur der Knopf.
   - Card „Warnhinweise“ (mit „anmeldungen-bearbeiten“ oder „nachweise-pruefen“): je Warnart eine Zeile, unvollständige Freizeitpässe
     (Link auf die Tabelle) und fehlende Nachweise (Meldung aus 1-6) mit dem Knopf „Nachweise prüfen“. Mit Zeilen oben „Achtung: …“; ohne
     Zeile „Keine offenen Punkte.“, aber nur, wenn alle Abrufe der Zeilen gelungen sind. Scheitert ein Abruf, entfällt seine Zeile.
   - Card „Freizeitpässe unvollständig“ (nur mit Personen im Stand): Tabelle mit Name, Stand und „Erinnern“ (Inline-Bestätigung, AD-13).
   Das Team sieht davon nichts. Mit „freizeitpaesse-sehen“ (Leitung und Team, Story 2-5) der Weg zu den Freizeitpässen, mit
   „freizeit-einstellungen“ (nur Leitung) der Weg zu den Einstellungen.
   Story 2-8: Während der Freizeit (Phase „läuft“) steht für alle Rollen direkt unter der Überschrift die Notfall-Box und darunter die
   Schnellsuche; in jeder Phase führt der Knopf „Sicherheitskette“ zur Sicherheitskette. Mit „freizeit-einstellungen“ lädt das Cockpit
   die Kette; ist sie nicht eingerichtet, steht unter „Warnhinweise“ die Zeile mit Link auf die Card in den Einstellungen.
   Story 3-1: in jeder Phase der Knopf „Programm“ zum Wochenraster. Story 3-3: daneben der Knopf „Inventar“ zum Inventar in der Freizeit.
   Story 2-9: Für alle Rollen lädt die Startseite das Schutzkonzept still mit (scheitert → keine Card). Gibt es eines, das die Person noch
   nicht bestätigt hat, und ist die Freizeit nicht abgeschlossen, steht die Card „Schutzkonzept“ da (kein Cockpit-Warnhinweis); der Knopf
   „Schutzkonzept“ steht in jeder Phase.
   Story 2-10: Mit „freizeit-einstellungen“ (Leitung) lädt das Cockpit still die Einträge des Vorfall-Protokolls; ab einem Eintrag steht die
   Card „Vorfall-Notizen“ (neueste oben, je Eintrag ein Link auf das Vorfall-Protokoll der Person). Sie ist kein Warnhinweis und zählt nicht
   in „Warnhinweise“; das Team sieht und lädt sie nicht.
   Story 3-5: Für alle Rollen lädt die Startseite (nicht nach dem Abschluss) still die Aufgaben: Card „Meine Aufgaben“ mit den eigenen offenen
   Aufgaben (Titel als Link), „Alle übernommenen Aufgaben sind erledigt.“ oder „Keine Aufgaben übernommen.“ und dem Link „Alle Aufgaben“, während der Freizeit darunter der Kurzlink „Schaden
   melden“. Im Cockpit der Leitung die Zeile „N Aufgaben sind noch nicht übernommen“ (offen, unbesetzt, Phase höchstens die der Freizeit) mit Link
   auf die Aufgaben. Scheitert der Abruf, entfallen Card und Zeile. Der Knopf „Aufgaben“ steht nach „Programm“.
   403/404 → „Diese Seite ist nicht verfügbar.“ *@
<PageTitle>@(_freizeit?.Name ?? "Freizeit") – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else if (_freizeit is null || _kontext is null)
{
    <h1>Freizeit</h1>
    @if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
    }
    else
    {
        <Ladezustand />
    }
}
else
{
    <h1>@_freizeit.Name</h1>
    @if (_kontext.Phase == Phase.Laeuft)
    {
        <NotfallBox Satz="@NotfallSatz" Ziel="@NotfallZiel" />
        @if (_personen is not null)
        {
            <Schnellsuche FreizeitId="FreizeitId" Label="Schnellsuche" Id="schnellsuche" Personen="_personen" />
        }
    }
    <p><Status Wort="@Anzeige.Phase(_kontext.Phase)" Art="@Anzeige.PhaseArt(_kontext.Phase)" /></p>
    <p>Zeitraum: @Anzeige.Zeitraum(_freizeit.ErsterTag, _freizeit.LetzterTag)</p>
    <p>Rolle: @Anzeige.Rollen(_kontext.Rollen)</p>
    @if (_freizeit.Leitung.Count > 0)
    {
        <p>Leitung: @string.Join(", ", _freizeit.Leitung.Select(l => Anzeige.Name(l.Vorname, l.Nachname)))</p>
    }
    <p>Einsicht in Freizeitpässe bis @Anzeige.Datum(_freizeit.FreigabeBis)</p>
    @if (SchutzkonzeptOffen)
    {
        <Card Titel="Schutzkonzept">
            <p>Das Schutzkonzept ist noch nicht als gelesen bestätigt.</p>
            <p><Knopf Href="@SchutzkonzeptZiel" Ansichtswechsel="true">Schutzkonzept lesen</Knopf></p>
        </Card>
    }
    @if (_aufgaben is not null)
    {
        <Card Titel="Meine Aufgaben" Id="meine-aufgaben">
            @if (!_aufgaben.Any(a => a.Meins))
            {
                <p>Keine Aufgaben übernommen.</p>
            }
            else if (MeineOffenen.Count == 0)
            {
                <p>Alle übernommenen Aufgaben sind erledigt.</p>
            }
            else
            {
                <ul>
                    @foreach (var aufgabe in MeineOffenen)
                    {
                        <li @key="aufgabe.Id"><a href="@ProgrammTexte.AufgabeZiel(FreizeitId, aufgabe.Id)">@aufgabe.Titel</a></li>
                    }
                </ul>
            }
            <p><a href="@ProgrammTexte.AufgabenZiel(FreizeitId)">Alle Aufgaben</a></p>
            @if (_kontext.Phase == Phase.Laeuft)
            {
                <p><a href="@($"freizeiten/{FreizeitId}/schaeden")">Schaden melden</a></p>
            }
        </Card>
    }
    @if (DarfAnmeldungen)
    {
        @if (_anmeldungen is not null)
        {
            <Card Titel="Anmeldungen">
                <PlaetzeBalken Uebersicht="_anmeldungen" />
                <p>@Anmeldestand("Teilnehmende", AnmeldungArt.Teilnehmende)</p>
                <p>@Anmeldestand("Mitarbeitende", AnmeldungArt.Mitarbeitende)</p>
                <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/anmeldungen")" Ansichtswechsel="true">Anmeldungen</Knopf></p>
            </Card>
        }
        else if (_cockpitGeladen)
        {
            <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/anmeldungen")" Ansichtswechsel="true">Anmeldungen</Knopf></p>
        }
    }
    @if (DarfCockpit && _cockpitGeladen)
    {
        <Card Titel="Warnhinweise">
            @if (AnzahlZeilen > 0)
            {
                <Meldung Titel="Achtung" Art="MeldungArt.Warnung">
                    <p>@Anzeige.OffenePunkte(AnzahlZeilen)</p>
                </Meldung>
                <ul>
                    @if (_stand is { Count: > 0 } stand)
                    {
                        <li><a href="@($"freizeiten/{FreizeitId}#{TabellenAnker}")">@Anzeige.FreizeitpaesseUnvollstaendig(stand.Count)</a></li>
                    }
                    @if (_personenMitWarnung is > 0 and var personen)
                    {
                        <li>Bei @(personen == 1 ? "1 Person" : $"{personen} Personen") im Team fehlen Nachweise oder laufen vor dem Ende der Freizeit ab.</li>
                    }
                    @if (KetteFehlt)
                    {
                        <li><a href="@($"freizeiten/{FreizeitId}/einstellungen#sicherheitskette")">Sicherheitskette ist noch nicht eingerichtet</a></li>
                    }
                    @if (AufgabenUnbesetzt > 0)
                    {
                        <li><a href="@ProgrammTexte.AufgabenZiel(FreizeitId)">@Anzeige.AufgabenUnbesetzt(AufgabenUnbesetzt)</a></li>
                    }
                </ul>
            }
            else if (AlleZeilenGeladen)
            {
                <Meldung Titel="Alles erledigt" Art="MeldungArt.Erfolg">
                    <p>Keine offenen Punkte.</p>
                </Meldung>
            }
            @if (DarfNachweise)
            {
                <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/nachweise")" Ansichtswechsel="true">Nachweise prüfen</Knopf></p>
            }
        </Card>
    }
    @if (DarfEinstellungen && _vorfaelle is { Count: > 0 } vorfaelle)
    {
        <Card Titel="Vorfall-Notizen" Id="vorfall-notizen">
            <Zeltlotse.App.Features.Sicherheit.VorfallNotizen Eintraege="vorfaelle" FreizeitId="FreizeitId" />
        </Card>
    }
    @if (DarfAnmeldungen && _stand is { Count: > 0 })
    {
        <Card Titel="Freizeitpässe unvollständig" Id="@TabellenAnker">
            @ErinnerungsMeldung
            <Datentabelle TZeile="FreizeitpassStandPerson" Beschriftung="Freizeitpässe unvollständig" Spalten="Spalten" Zeilen="_stand" />
        </Card>
    }
    else
    {
        @ErinnerungsMeldung
    }
    @* Story 3-1: Das Programm (Wochenraster) ist in jeder Phase für Leitung und Team erreichbar; eine Navigation gibt es noch nicht. *@
    <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/programm")" Ansichtswechsel="true">Programm</Knopf></p>
    @* Story 3-5: Die Aufgaben der Freizeit, in jeder Phase für Leitung und Team. *@
    <p><Knopf Art="KnopfArt.Outline" Href="@ProgrammTexte.AufgabenZiel(FreizeitId)" Ansichtswechsel="true">Aufgaben</Knopf></p>
    @* Story 3-3: Das Inventar der Organisation mit den Reservierungen dieser Freizeit, in jeder Phase für Leitung und Team. *@
    <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/inventar")" Ansichtswechsel="true">Inventar</Knopf></p>
    @* Story 3-4: Schäden, Verluste und Entnahmen der Freizeit, in jeder Phase für Leitung und Team (nach dem Abschluss Anschaffungswünsche). *@
    <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/schaeden")" Ansichtswechsel="true">Schäden &amp; Verluste</Knopf></p>
    @* Story 2-8: Die Sicherheitskette ist in jeder Phase für Leitung und Team erreichbar. *@
    <p><Knopf Art="KnopfArt.Outline" Href="@NotfallZiel" Ansichtswechsel="true">Sicherheitskette</Knopf></p>
    @* Story 2-9: Das Schutzkonzept ist in jeder Phase für Leitung und Team erreichbar. *@
    <p><Knopf Art="KnopfArt.Outline" Href="@SchutzkonzeptZiel" Ansichtswechsel="true">Schutzkonzept</Knopf></p>
    @if (FreizeitKontextDienst.Darf(_kontext, Aktionsschluessel.FreizeitpaesseSehen))
    {
        <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/freizeitpaesse")" Ansichtswechsel="true">Freizeitpässe</Knopf></p>
    }
    @* Story 2-7: Dokumente für Leitung und Team (keine Leitungsaufgabe, darum ohne Aktionsschlüssel). *@
    <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/dokumente")" Ansichtswechsel="true">Dokumente</Knopf></p>
    @if (FreizeitKontextDienst.Darf(_kontext, Aktionsschluessel.FreizeitEinstellungen))
    {
        <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/einstellungen")" Ansichtswechsel="true">Einstellungen</Knopf></p>
    }
}

@code {
    /// <summary>Sprungziel der Tabelle „Freizeitpässe unvollständig“ für den Link in den Warnhinweisen.</summary>
    private const string TabellenAnker = "freizeitpaesse-offen";

    private FreizeitKontext? _kontext;
    private FreizeitAntwort? _freizeit;
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _cockpitGeladen;
    private AnmeldungenUebersicht? _anmeldungen;
    private List<FreizeitpassStandPerson>? _stand;
    private int? _personenMitWarnung;
    private Zeltlotse.Api.Contracts.Sicherheit.Sicherheitskette? _kette;
    private List<PersonenlisteZeile>? _personen;
    private Zeltlotse.Api.Contracts.Sicherheit.Schutzkonzept? _schutzkonzept;
    private List<Zeltlotse.Api.Contracts.Sicherheit.VorfallEintrag>? _vorfaelle;
    private List<Zeltlotse.Api.Contracts.Programm.Aufgabe>? _aufgaben;
    private bool _uebertraegt;
    private string? _meldung;
    private bool _meldungFehler;

    [Parameter] public Guid FreizeitId { get; set; }

    private bool DarfAnmeldungen => _kontext is not null && FreizeitKontextDienst.Darf(_kontext, Aktionsschluessel.AnmeldungenBearbeiten);

    private bool DarfNachweise => _kontext is not null && FreizeitKontextDienst.Darf(_kontext, Aktionsschluessel.NachweisePruefen);

    private bool DarfEinstellungen => _kontext is not null && FreizeitKontextDienst.Darf(_kontext, Aktionsschluessel.FreizeitEinstellungen);

    /// <summary>Das Cockpit mit der Card „Warnhinweise“ gehört der Leitung (eine der drei Leitungs-Aktionen).</summary>
    private bool DarfCockpit => DarfAnmeldungen || DarfNachweise || DarfEinstellungen;

    /// <summary>
    /// Story 2-8: Die Kette ist geladen und nicht eingerichtet (scheitert der Abruf, entfällt die Zeile). Nach dem Abschluss lässt sie sich
    /// nicht mehr einrichten; dann gibt es keine Zeile.
    /// </summary>
    private bool KetteFehlt => DarfEinstellungen && _kette is { Eingerichtet: false } && _kontext!.Phase != Phase.Gelaufen;

    /// <summary>Story 2-8: Ziel der Notfall-Box und des Knopfs „Sicherheitskette“.</summary>
    private string NotfallZiel => $"freizeiten/{FreizeitId}/notfall";

    /// <summary>Story 2-9: Ziel der Card und des Knopfs „Schutzkonzept“.</summary>
    private string SchutzkonzeptZiel => $"freizeiten/{FreizeitId}/schutzkonzept";

    /// <summary>Story 2-9: Ein Schutzkonzept ist angehängt, die Person hat es noch nicht bestätigt, und die Freizeit ist nicht abgeschlossen.</summary>
    private bool SchutzkonzeptOffen =>
        _schutzkonzept is { DokumentId: not null, SelbstGelesenAm: null } && _kontext is not null && _kontext.Phase != Phase.Gelaufen;

    private const string NotfallSatz = "Was jetzt zu tun ist, wen anrufen und die Freizeitpässe – ein Tipp entfernt.";

    /// <summary>Zeilen der Card „Warnhinweise“: je vorhandener Warnart eine.</summary>
    private int AnzahlZeilen =>
        (_stand is { Count: > 0 } ? 1 : 0) + (_personenMitWarnung is > 0 ? 1 : 0) + (KetteFehlt ? 1 : 0) + (AufgabenUnbesetzt > 0 ? 1 : 0);

    /// <summary>Alle Abrufe, aus denen Zeilen entstehen können, sind gelungen (die Aufgaben nur vor dem Abschluss).</summary>
    private bool AlleZeilenGeladen =>
        (!DarfAnmeldungen || _stand is not null) && (!DarfNachweise || _personenMitWarnung is not null) && (!DarfEinstellungen || _kette is not null)
        && (_kontext!.Phase == Phase.Gelaufen || _aufgaben is not null);

    /// <summary>Story 3-5: offene, unbesetzte Aufgaben bis zur Phase der Freizeit (nicht nach dem Abschluss; ohne Aufgaben 0).</summary>
    private int AufgabenUnbesetzt =>
        _aufgaben is null || _kontext is null || _kontext.Phase == Phase.Gelaufen ? 0 : ProgrammTexte.AufgabenUnbesetzt(_aufgaben, _kontext.Phase);

    /// <summary>Story 3-5: eigene, nicht erledigte Aufgaben für die Card „Meine Aufgaben“.</summary>
    private List<Zeltlotse.Api.Contracts.Programm.Aufgabe> MeineOffenen => [.. (_aufgaben ?? []).Where(a => a.Meins && !a.Erledigt)];

    private string Anmeldestand(string titel, AnmeldungArt art)
    {
        var zeilen = _anmeldungen!.Anmeldungen.Where(a => a.Art == art).ToList();
        return Anzeige.Anmeldestand(titel, zeilen.Count(a => a.Status == AnmeldungStatus.Eingegangen), zeilen.Count(a => a.Status == AnmeldungStatus.Bestaetigt));
    }

    private IReadOnlyList<Spalte<FreizeitpassStandPerson>> Spalten =>
    [
        new("Name", p => @<a href="@($"freizeiten/{FreizeitId}/freizeitpaesse/{p.PersonId}")">@Anzeige.Name(p.Vorname, p.Nachname)</a>),
        new("Stand", p => @<Status Wort="@Anzeige.FreizeitpassStand(p.Gefragt, p.Offen)" Art="StatusArt.Warnung" />),
        new("Erinnerung", p => @<text>
            @if (p.ErinnertAm is { } erinnertAm)
            {
                <p>Erinnert am @Anzeige.Datum(erinnertAm)</p>
            }
            <InlineBestaetigung AusloeserText="Erinnern" AusloeserArt="KnopfArt.Outline"
                                Satz="@($"Erinnerung zum Freizeitpass von {Anzeige.Name(p.Vorname, p.Nachname)} senden?")"
                                JaText="Ja, senden" Bestaetigt="@(() => ErinnernAsync(p))" />
        </text>),
    ];

    private RenderFragment ErinnerungsMeldung => @<text>
        @if (_aktionFehler && _freizeit is not null)
        {
            <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                <p>@AnmeldungAbschluss.FehlerText</p>
            </Meldung>
        }
        @if (_meldung is not null)
        {
            <Meldung Titel="@(_meldungFehler ? "Fehler" : "Gesendet")" Art="@(_meldungFehler ? MeldungArt.Fehler : MeldungArt.Erfolg)">
                <p>@_meldung</p>
            </Meldung>
        }
    </text>;

    protected override async Task OnParametersSetAsync()
    {
        _kontext = null;
        _freizeit = null;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _cockpitGeladen = false;
        _anmeldungen = null;
        _stand = null;
        _personenMitWarnung = null;
        _kette = null;
        _personen = null;
        _schutzkonzept = null;
        _vorfaelle = null;
        _aufgaben = null;
        _meldung = null;
        try
        {
            var kontext = Kontext.LadenAsync(FreizeitId);
            var freizeit = Freizeiten.LadenAsync(FreizeitId);
            await Task.WhenAll(kontext, freizeit);
            (_kontext, _freizeit) = (kontext.Result, freizeit.Result);
            _nichtVerfuegbar = _kontext is null || _freizeit is null;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (offline, 5xx) die Meldung statt „Wird geladen …“.
            _aktionFehler = true;
            return;
        }

        if (_nichtVerfuegbar)
        {
            return;
        }

        // Story 2-8: Während der Freizeit lädt die Startseite für alle Rollen die Personenliste der Schnellsuche (scheitert → keine Suche).
        var personen = _kontext!.Phase == Phase.Laeuft ? SicherAsync(() => Freizeiten.PersonenlisteLadenAsync(FreizeitId)) : Task.FromResult<List<PersonenlisteZeile>?>(null);
        // Story 2-9: das Schutzkonzept für die Card (nicht nach dem Abschluss; scheitert → keine Card).
        var schutzkonzept = _kontext.Phase != Phase.Gelaufen
            ? SicherAsync(() => SicherheitApi.SchutzkonzeptLadenAsync(FreizeitId))
            : Task.FromResult<Zeltlotse.Api.Contracts.Sicherheit.Schutzkonzept?>(null);
        // Story 3-5: die Aufgaben für „Meine Aufgaben“ und den Warnhinweis (nicht nach dem Abschluss; scheitert → weder Card noch Zeile).
        var aufgaben = _kontext.Phase != Phase.Gelaufen
            ? SicherAsync(() => ProgrammApi.AufgabenAsync(FreizeitId))
            : Task.FromResult<List<Zeltlotse.Api.Contracts.Programm.Aufgabe>?>(null);
        if (!DarfCockpit)
        {
            await Task.WhenAll(personen, schutzkonzept, aufgaben);
            (_personen, _schutzkonzept, _aufgaben) = (personen.Result, schutzkonzept.Result, aufgaben.Result);
            return;
        }

        // Die Teile des Cockpits laden parallel; jeder fängt seine Fehler selbst (Abruf scheitert → Teil entfällt).
        var anmeldungen = DarfAnmeldungen ? SicherAsync(() => Freizeiten.AnmeldungenAsync(FreizeitId)) : Task.FromResult<AnmeldungenUebersicht?>(null);
        var stand = DarfAnmeldungen ? StandLadenAsync() : Task.FromResult<List<FreizeitpassStandPerson>?>(null);
        var warnungen = DarfNachweise ? WarnungenLadenAsync() : Task.FromResult<int?>(null);
        var kette = DarfEinstellungen ? SicherAsync(() => SicherheitApi.SicherheitsketteLadenAsync(FreizeitId)) : Task.FromResult<Zeltlotse.Api.Contracts.Sicherheit.Sicherheitskette?>(null);
        // Story 2-10: die Vorfall-Notizen für die Leitung (scheitert → keine Card).
        var vorfaelle = DarfEinstellungen
            ? SicherAsync(() => SicherheitApi.VorfaelleLadenAsync(FreizeitId))
            : Task.FromResult<List<Zeltlotse.Api.Contracts.Sicherheit.VorfallEintrag>?>(null);
        await Task.WhenAll(anmeldungen, stand, warnungen, kette, personen, schutzkonzept, vorfaelle, aufgaben);
        (_anmeldungen, _stand, _personenMitWarnung, _kette, _personen) = (anmeldungen.Result, stand.Result, warnungen.Result, kette.Result, personen.Result);
        (_schutzkonzept, _vorfaelle, _aufgaben) = (schutzkonzept.Result, vorfaelle.Result, aufgaben.Result);
        _cockpitGeladen = true;
    }

    /// <summary>Freizeitpass-Stand (Story 2-6); <c>null</c>, wenn der Abruf scheitert.</summary>
    private async Task<List<FreizeitpassStandPerson>?> StandLadenAsync() =>
        (await SicherAsync(() => Personen.FreizeitpassStandLadenAsync(FreizeitId)))?.Personen.ToList();

    /// <summary>Warnhinweise zu Pflicht-Nachweisen (FR-11): Personen mit Warnung; <c>null</c>, wenn der Abruf scheitert.</summary>
    private async Task<int?> WarnungenLadenAsync() =>
        (await SicherAsync(() => Freizeiten.NachweisWarnungenLadenAsync(FreizeitId)))?.Personen.Count(p => p.Warnungen.Count > 0);

    private static async Task<T?> SicherAsync<T>(Func<Task<T?>> abruf)
        where T : class
    {
        try
        {
            return await abruf();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            return null;
        }
    }

    private async Task ErinnernAsync(FreizeitpassStandPerson person)
    {
        // Zweimal ausgelöst, während die erste Anfrage noch läuft: nur einmal senden.
        if (_uebertraegt)
        {
            return;
        }

        _uebertraegt = true;
        _aktionFehler = false;
        _meldung = null;
        var name = Anzeige.Name(person.Vorname, person.Nachname);
        try
        {
            switch (await Personen.FreizeitpassErinnernAsync(FreizeitId, person.PersonId))
            {
                case ErinnerungErgebnis.Gesendet:
                    (_meldung, _meldungFehler) = ($"Die Erinnerung zum Freizeitpass von {name} geht per Mail hinaus.", false);
                    break;
                case ErinnerungErgebnis.SchonHeute:
                    (_meldung, _meldungFehler) = ($"Zum Freizeitpass von {name} wurde heute schon erinnert.", true);
                    break;
                default:
                    (_meldung, _meldungFehler) = ("Die Erinnerung ließ sich nicht senden.", true);
                    break;
            }

            // Scheitert das Neuladen, bleibt die bisherige Liste stehen.
            _stand = await StandLadenAsync() ?? _stand;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
