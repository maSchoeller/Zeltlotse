@page "/freizeiten/{FreizeitId:guid}/anmeldungen"
@using Zeltlotse.Api.Contracts.Freizeiten
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Ui.Kontext
@inject FreizeitKontextDienst Kontext
@inject FreizeitenApiClient Freizeiten
@* Anmeldungen (EXPERIENCE.md → Fläche „Anmeldungen“, nur Leitung; FR-20, FR-21, FR-67, Story 2-3): Balken „Plätze“ (PlaetzeBalken) mit den bestätigten
   Teilnehmenden gegen die Höchstzahl (belegt, ausgebucht = Warnung, überbelegt = Fehler; ohne Höchstzahl nur die Zahl) und je ein
   Abschnitt „Teilnehmende“ und „Mitarbeitende“ als Datentabelle mit Name, Eingang, Status und Aktion. Eingegangen: „Bestätigen“ (direkt,
   die ausdrückliche Aktion nach AD-13) und „Absage eintragen“ mit Inline-Bestätigung; bestätigt: nur die Absage; abgesagt: keine Aktion.
   Nach jeder Entscheidung eine Meldung und die Liste lädt neu. Bestätigen bleibt auch bei voller Freizeit möglich (die Leitung
   entscheidet, der Balken zeigt die Überschreitung). Ohne die erlaubte Aktion „anmeldungen-bearbeiten“ oder bei 403/404 → „Diese Seite
   ist nicht verfügbar.“; 409 → „Diese Anmeldung wurde schon entschieden.“ und Neuladen. *@
<PageTitle>Anmeldungen – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else
{
    <h1>Anmeldungen</h1>
    <p><a href="@($"freizeiten/{FreizeitId}")">Zurück zur Freizeit</a></p>

    @if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
    }
    @if (_meldung is not null)
    {
        <Meldung Titel="@(_meldungHinweis ? "Hinweis" : "Gespeichert")" Art="@(_meldungHinweis ? MeldungArt.Hinweis : MeldungArt.Erfolg)">
            <p>@_meldung</p>
        </Meldung>
    }

    @if (_uebersicht is null)
    {
        @if (!_aktionFehler)
        {
            <Ladezustand />
        }
    }
    else
    {
        <PlaetzeBalken Uebersicht="_uebersicht" />

        @foreach (var (titel, art) in Abschnitte)
        {
            var zeilen = _uebersicht.Anmeldungen.Where(a => a.Art == art).ToList();
            <h2>@titel</h2>
            @if (zeilen.Count == 0)
            {
                <LeerZustand Satz="Noch keine Anmeldungen." />
            }
            else
            {
                <Datentabelle TZeile="LeitungAnmeldungZeile" Beschriftung="@titel" Spalten="Spalten" Zeilen="zeilen" />
            }
        }
    }
}

@code {
    private static readonly (string Titel, AnmeldungArt Art)[] Abschnitte =
        [("Teilnehmende", AnmeldungArt.Teilnehmende), ("Mitarbeitende", AnmeldungArt.Mitarbeitende)];

    private AnmeldungenUebersicht? _uebersicht;
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _uebertraegt;
    private string? _meldung;
    private bool _meldungHinweis;

    [Parameter] public Guid FreizeitId { get; set; }

    private IReadOnlyList<Spalte<LeitungAnmeldungZeile>> Spalten =>
    [
        new("Name", a => @<text>@Anzeige.Name(a.Vorname, a.Nachname)</text>),
        new("Eingegangen", a => @<text>@Anzeige.Datum(a.EingegangenAm)</text>),
        new("Status", a => @<Status Wort="@Anzeige.Status(a.Status)" Art="@Anzeige.AnmeldungStatusArt(a.Status)" />),
        new("Aktion", a => @<text>
            @if (a.Status == AnmeldungStatus.Eingegangen)
            {
                <Knopf Deaktiviert="@_uebertraegt" @onclick="@(() => EntscheidenAsync(a, bestaetigen: true))">Bestätigen</Knopf>
            }
            @if (a.Status != AnmeldungStatus.Abgesagt)
            {
                <InlineBestaetigung AusloeserText="Absage eintragen" AusloeserArt="KnopfArt.Outline"
                                    Satz="@($"Absage für {Vorname(a)} eintragen? Eine Absage-Mail geht raus.")"
                                    JaText="Ja, Absage eintragen" Bestaetigt="@(() => EntscheidenAsync(a, bestaetigen: false))" />
            }
        </text>),
    ];

    private static string Vorname(LeitungAnmeldungZeile anmeldung) =>
        string.IsNullOrWhiteSpace(anmeldung.Vorname) ? Anzeige.Name(null, anmeldung.Nachname) : anmeldung.Vorname.Trim();

    protected override async Task OnParametersSetAsync()
    {
        _uebersicht = null;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _meldung = null;
        try
        {
            var kontext = await Kontext.LadenAsync(FreizeitId);
            if (kontext is null || !FreizeitKontextDienst.Darf(kontext, Aktionsschluessel.AnmeldungenBearbeiten))
            {
                _nichtVerfuegbar = true;
                return;
            }

            await NeuLadenAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (offline, 5xx) die Meldung statt „Wird geladen …“.
            _aktionFehler = true;
        }
    }

    private async Task NeuLadenAsync()
    {
        _uebersicht = await Freizeiten.AnmeldungenAsync(FreizeitId);
        _nichtVerfuegbar = _uebersicht is null;
    }

    private async Task EntscheidenAsync(LeitungAnmeldungZeile anmeldung, bool bestaetigen)
    {
        // Zweimal ausgelöst, während die erste Anfrage noch läuft: nur einmal entscheiden.
        if (_uebertraegt)
        {
            return;
        }

        _uebertraegt = true;
        _aktionFehler = false;
        _meldung = null;
        var vorname = Vorname(anmeldung);
        try
        {
            var ergebnis = bestaetigen
                ? await Freizeiten.BestaetigenAsync(FreizeitId, anmeldung.AnmeldungId)
                : await Freizeiten.AbsagenAsync(FreizeitId, anmeldung.AnmeldungId);
            switch (ergebnis)
            {
                case EntscheidungErgebnis.Entschieden:
                    (_meldung, _meldungHinweis) = (bestaetigen
                        ? $"{vorname} ist bestätigt. Eine Mail geht raus."
                        : $"Absage für {vorname} eingetragen. Eine Mail geht raus.", false);
                    break;
                case EntscheidungErgebnis.SchonEntschieden:
                    (_meldung, _meldungHinweis) = ("Diese Anmeldung wurde schon entschieden.", true);
                    break;
                default:
                    _nichtVerfuegbar = true;
                    return;
            }

            await NeuLadenAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
