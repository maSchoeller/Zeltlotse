@using Zeltlotse.Api.Contracts.Freizeiten
@* Schnellsuche (EXPERIENCE.md → Component Patterns „Schnellsuche“, FR-28, Story 2-8): sucht in der Personenliste der Freizeit (Freizeiten,
   AD-2) im Client ab dem ersten Zeichen nach Vor- und Nachnamen. Treffer stehen als Personenliste mit Initialen, Name und Art der
   Anmeldung; der Name öffnet direkt den Freizeitpass (Personen, AD-8). Über den Treffern steht für Screenreader angesagt
   (role="status") „Keine Person gefunden.“, „1 Person gefunden.“ oder „<n> Personen gefunden.“; ohne Eingabe nichts. *@
<Feld Label="@Label" Id="@Id" Typ="search" Wert="@_suche" autocomplete="off" @oninput="@(e => _suche = e.Value?.ToString())" />
@if (!string.IsNullOrWhiteSpace(_suche))
{
    var treffer = Treffer;
    <p role="status">@TrefferText(treffer.Count)</p>
    <PersonenListe Personen="treffer" />
}

@code {
    private string? _suche;

    [Parameter, EditorRequired] public Guid FreizeitId { get; set; }

    /// <summary>Sichtbares Label, z. B. „Betroffene Person suchen“.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Die Personenliste der Freizeit aus <c>FreizeitenApiClient.PersonenlisteLadenAsync</c>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<PersonenlisteZeile> Personen { get; set; } = [];

    private static string TrefferText(int anzahl) => anzahl switch
    {
        0 => "Keine Person gefunden.",
        1 => "1 Person gefunden.",
        _ => $"{anzahl} Personen gefunden.",
    };

    private List<PersonenEintrag> Treffer =>
    [
        .. Personen
            .Where(p => Anzeige.TitelTrifft(Anzeige.Name(p.Vorname, p.Nachname), _suche))
            .Select(p => new PersonenEintrag(
                Anzeige.Initialen(p.Vorname, p.Nachname),
                Anzeige.Name(p.Vorname, p.Nachname),
                p.Art == AnmeldungArt.Teilnehmende ? "Teilnehmende" : "Mitarbeitende",
                $"freizeiten/{FreizeitId}/freizeitpaesse/{p.PersonId}")),
    ];
}
