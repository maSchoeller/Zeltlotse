@using Zeltlotse.Api.Contracts.Freizeiten
@using Zeltlotse.Api.Contracts.Personen
@* Schnellsuche (EXPERIENCE.md → Component Patterns „Schnellsuche“, FR-28, Story 2-8): sucht in der Personenliste der Freizeit (Freizeiten,
   AD-2) im Client ab dem ersten Zeichen nach Vor- und Nachnamen. Treffer stehen als Personenliste mit Initialen, Name und Art der
   Anmeldung; der Name öffnet direkt den Freizeitpass (Personen, AD-8). Über den Treffern steht für Screenreader angesagt
   (role="status") „Keine Person gefunden.“, „1 Person gefunden.“ oder „<n> Personen gefunden.“; ohne Eingabe nichts. Story 6-5: Offline sucht sie
   in den Personen der gespeicherten Notfallkarte; ein Treffer öffnet dann die Notfallkarte der Person. *@
<Feld Label="@Label" Id="@Id" Typ="search" Wert="@_suche" autocomplete="off" @oninput="@(e => _suche = e.Value?.ToString())" />
@if (!string.IsNullOrWhiteSpace(_suche))
{
    var treffer = Treffer;
    <p role="status">@TrefferText(treffer.Count)</p>
    <PersonenListe Personen="treffer" />
}

@code {
    private string? _suche;

    [Parameter, EditorRequired] public Guid FreizeitId { get; set; }

    /// <summary>Sichtbares Label, z. B. „Betroffene Person suchen“.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Die Personenliste der Freizeit aus <c>FreizeitenApiClient.PersonenlisteLadenAsync</c>.</summary>
    [Parameter] public IReadOnlyList<PersonenlisteZeile> Personen { get; set; } = [];

    /// <summary>Story 6-5: Offline die Personen der gespeicherten Notfallkarte; gesetzt, sucht die Suche nur dort und führt zur Notfallkarte.</summary>
    [Parameter] public IReadOnlyList<NotfallkartePerson>? Notfallkarte { get; set; }

    private static string TrefferText(int anzahl) => anzahl switch
    {
        0 => "Keine Person gefunden.",
        1 => "1 Person gefunden.",
        _ => $"{anzahl} Personen gefunden.",
    };

    private List<PersonenEintrag> Treffer => Notfallkarte is { } karte
        ? [.. karte.Where(p => Trifft(p.Vorname, p.Nachname)).Select(p => Eintrag(p.Vorname, p.Nachname, "Notfallkarte", $"notfallkarte/{p.PersonId}"))]
        : [.. Personen.Where(p => Trifft(p.Vorname, p.Nachname)).Select(p => Eintrag(
            p.Vorname, p.Nachname, p.Art == AnmeldungArt.Teilnehmende ? "Teilnehmende" : "Mitarbeitende", $"freizeitpaesse/{p.PersonId}"))];

    private bool Trifft(string? vorname, string? nachname) => Anzeige.TitelTrifft(Anzeige.Name(vorname, nachname), _suche);

    private PersonenEintrag Eintrag(string? vorname, string? nachname, string zeile, string ziel) =>
        new(Anzeige.Initialen(vorname, nachname), Anzeige.Name(vorname, nachname), zeile, $"freizeiten/{FreizeitId}/{ziel}");
}
