@page "/einladung/{Token}"
@inject OrganisationenApiClient Organisationen
@inject NavigationManager Navigation
@* Einladung aus der Mail (AD-11, FR-5): Der Aufruf zeigt nur diese Seite; angenommen wird erst beim Klick (POST), damit
   Mail-Scanner die Einladung nicht verbrauchen. Ohne Sitzung führt der Klick zur Anmeldung, und die App kehrt danach
   hierher zurück (Rückweg nur im Speicher). Das Token verlässt die Seite nur im Körper des POST. *@
<PageTitle>Einladung annehmen – Zeltlotse</PageTitle>

<h1>Einladung annehmen</h1>

@if (_aktionFehler)
{
    <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
        <p>@AnmeldungAbschluss.FehlerText</p>
    </Meldung>
}
@if (_ungueltig)
{
    <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
        <p>Diese Einladung ist nicht mehr gültig oder gilt für eine andere Mail-Adresse.</p>
    </Meldung>
}

<p>Die Einladung gilt für die Mail-Adresse, an die sie ging. Mit „Einladung annehmen“ wird die Rolle in der Organisation übernommen; ohne Anmeldung geht es vorher zur Seite „Anmelden“.</p>
<Knopf Deaktiviert="@_uebertraegt" @onclick="AnnehmenAsync">Einladung annehmen</Knopf>

@code {
    private bool _ungueltig;
    private bool _uebertraegt;
    private bool _aktionFehler;

    /// <summary>Das Token aus dem Link; es verlässt die Seite nur im Körper des POST.</summary>
    [Parameter] public string Token { get; set; } = "";

    private async Task AnnehmenAsync()
    {
        _uebertraegt = true;
        _aktionFehler = false;
        _ungueltig = false;
        try
        {
            if (await Organisationen.AnnehmenAsync(Token) is { } organisationId)
            {
                Navigation.NavigateTo($"organisationen/{organisationId}");
                return;
            }

            _ungueltig = true;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
