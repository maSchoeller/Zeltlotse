@page "/organisationen/{OrgId:guid}"
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Api.Contracts.Organisationen
@inject OrganisationenApiClient Organisationen
@* Organisation (EXPERIENCE.md → Flächen „Organisation verwalten“, FR-5, FR-6): Name, eigene Rolle und die Freizeiten der
   Organisation (FreizeitenKarten); mit „nachweise-pruefen“ der Weg zur Prüfliste, mit „nachweis-richtlinie-verwalten“ die
   Richtlinie für Nachweise (Autosave je Zelle), mit „loeschfristen-verwalten“ die Löschfristen (Autosave, NFR-5); nur mit der erlaubten
   Aktion „org-rollen-vergeben“ (AD-29) die Rollen, die offenen Einladungen und das Formular „Person einladen“. Die
   Oberfläche entscheidet nur über „erlaubt“, nie über die Rollen. Story 2-10: mit „vorfall-archiv-sehen“ die Card „Vorfall-Notizen“
   mit dem Weg ins Archiv. Story 3-3: mit „inventar-sehen“ (Org-Admin und Org-Überblick) die Card „Inventar“ mit dem Weg zum Inventar. Story 3-5: mit
   „aufgaben-vorlagen-verwalten“ (Org-Admin) die Card „Aufgaben-Vorlagen“ mit dem Weg zu den Vorlagen.
   403/404 → „Diese Seite ist nicht verfügbar.“ *@
<PageTitle>@(_organisation?.Name ?? "Organisation") – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else if (_organisation is null)
{
    <h1>Organisation</h1>
    @if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
    }
    else
    {
        <Ladezustand />
    }
}
else
{
    <h1>@_organisation.Name</h1>
    <p>Rolle: @Anzeige.Rollen(_organisation.Rollen)</p>

    @if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
    }

    @if (Darf(Aktionsschluessel.NachweisePruefen))
    {
        <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/nachweise")" Ansichtswechsel="true">Nachweise prüfen</Knopf></p>
    }

    <FreizeitenKarten OrgId="OrgId" />

    @if (Darf(Aktionsschluessel.OrgDokumenteVerwalten))
    {
        <Card Titel="Org-Dokumente">
            <p>Dokumente der Organisation, etwa eine Hausordnung, binden Freizeiten ein, ohne sie zu kopieren.</p>
            <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/dokumente")" Ansichtswechsel="true">Org-Dokumente öffnen</Knopf></p>
        </Card>
    }

    @if (Darf(Aktionsschluessel.InventarSehen))
    {
        @* Story 3-3: das Inventar der Organisation mit den Reservierungen aller Freizeiten. *@
        <Card Titel="Inventar">
            <p>Material der Organisation, das Freizeiten für ihren Zeitraum reservieren.</p>
            <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/inventar")" Ansichtswechsel="true">Inventar öffnen</Knopf></p>
        </Card>
        @* Story 3-4: Schäden und Verluste abgeschlossener Freizeiten als Anschaffungswünsche. *@
        <Card Titel="Anschaffungswünsche">
            <p>Nach dem Abschluss einer Freizeit stehen ihre Schäden und Verluste hier, bis sie erledigt sind.</p>
            <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/anschaffungswuensche")" Ansichtswechsel="true">Anschaffungswünsche öffnen</Knopf></p>
        </Card>
    }

    @if (Darf(Aktionsschluessel.AufgabenVorlagenVerwalten))
    {
        @* Story 3-5: Aufgaben-Vorlagen, die neue Freizeiten beim ersten Öffnen ihrer Aufgaben übernehmen. *@
        <Card Titel="Aufgaben-Vorlagen">
            <p>Wiederkehrende Aufgaben, die jede neue Freizeit der Organisation schon in ihren Aufgaben findet.</p>
            <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/aufgaben-vorlagen")" Ansichtswechsel="true">Aufgaben-Vorlagen öffnen</Knopf></p>
        </Card>
    }

    @if (Darf(Aktionsschluessel.VorfallArchivSehen))
    {
        @* Story 2-10: das Archiv der Vorfall-Notizen abgeschlossener Freizeiten. *@
        <Card Titel="Vorfall-Notizen">
            <p>Nach dem Abschluss einer Freizeit liegen ihre Vorfall-Notizen hier, bis die Frist für Freizeit-Daten abläuft.</p>
            <p><Knopf Art="KnopfArt.Outline" Href="@($"organisationen/{OrgId}/vorfall-archiv")" Ansichtswechsel="true">Archiv öffnen</Knopf></p>
        </Card>
    }

    @if (Darf(Aktionsschluessel.NachweisRichtlinieVerwalten))
    {
        <Card Titel="Richtlinie für Nachweise">
            <p>„Gültig (Monate)“ zählt ab dem Ausstellungsdatum. Die Bestätigung gilt bis Ausstellungsdatum plus diese Monate.</p>
            @if (_richtlinieFehlt)
            {
                <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                    <p>@AnmeldungAbschluss.FehlerText</p>
                </Meldung>
            }
            else if (_richtlinie is null)
            {
                @if (!_aktionFehler)
                {
                    <Ladezustand />
                }
            }
            else
            {
                <Datentabelle TZeile="RichtlinieZeile" Beschriftung="Richtlinie für Nachweise" Spalten="RichtlinienSpalten" Zeilen="_richtlinie" />
            }
        </Card>
    }

    @if (Darf(Aktionsschluessel.LoeschfristenVerwalten))
    {
        <Card Titel="Löschfristen">
            <p>Nach diesen Fristen löscht Zeltlotse die Daten endgültig.</p>
            @if (_loeschfristenFehlen)
            {
                <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                    <p>@AnmeldungAbschluss.FehlerText</p>
                </Meldung>
            }
            else if (_loeschfristen is null)
            {
                @if (!_aktionFehler)
                {
                    <Ladezustand />
                }
            }
            else
            {
                <AutosaveFeld Label="Daten einer Freizeit (Monate nach Freizeitende)" Id="loeschfristen-freizeit" Typ="number" Hinweis="1 bis 120 Monate"
                              Feldname="@LoeschfristFelder.FreizeitDatenMonate" Pfad="@OrganisationenApiClient.LoeschfristenPfad(OrgId)"
                              Wert="@_loeschfristen.FreizeitDatenMonate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              Version="@_loeschfristen.Version" NeuLaden="LoeschfristenLadenAsync" />
                <AutosaveFeld Label="Abgelaufene Nachweis-Bestätigungen (Monate nach Ablauf)" Id="loeschfristen-bestaetigungen" Typ="number" Hinweis="1 bis 120 Monate"
                              Feldname="@LoeschfristFelder.NachweisBestaetigungMonate" Pfad="@OrganisationenApiClient.LoeschfristenPfad(OrgId)"
                              Wert="@_loeschfristen.NachweisBestaetigungMonate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              Version="@_loeschfristen.Version" NeuLaden="LoeschfristenLadenAsync" />
            }
        </Card>
    }

    @if (RollenVergeben)
    {
        <Card Titel="Rollen">
            @if (_rollen is null)
            {
                @if (!_aktionFehler)
                {
                    <Ladezustand />
                }
            }
            else
            {
                <Datentabelle TZeile="RollenPerson" Beschriftung="Rollen" Spalten="RollenSpalten" Zeilen="_rollen.Personen" />
            }
        </Card>

        <Card Titel="Offene Einladungen">
            @if (_rollen is not null)
            {
                @if (_rollen.Einladungen.Count == 0)
                {
                    <LeerZustand Satz="Keine offenen Einladungen." />
                }
                else
                {
                    <Datentabelle TZeile="OffeneEinladung" Beschriftung="Offene Einladungen" Spalten="EinladungsSpalten" Zeilen="_rollen.Einladungen" />
                }
            }
        </Card>

        <Card Titel="Person einladen">
            @if (_eingeladen)
            {
                <Meldung Titel="Gespeichert" Art="MeldungArt.Erfolg">
                    <p>Die Einladung ist verschickt.</p>
                </Meldung>
            }
            <Formular Absenden="EinladenAsync">
                <Feld Label="Mail-Adresse" Id="einladen-mail" Typ="email" Wert="@_mail" Fehler="@_mailFehler"
                      autocomplete="off" @oninput="@(e => _mail = e.Value?.ToString())" />
                <Auswahl Legende="Rolle" Gruppe="einladen-rolle" Optionen="RollenOptionen" Wert="@_rolle?.ToString()"
                         Fehler="@_rolleFehler" WertGeaendert="@(w => _rolle = Enum.Parse<OrgRolle>(w))" />
                <Knopf Typ="submit" Deaktiviert="@_uebertraegt">Einladung schicken</Knopf>
            </Formular>
        </Card>
    }
}

@code {
    private static readonly IReadOnlyList<Spalte<RollenPerson>> RollenSpalten =
    [
        new("Name", p => @<text>@Anzeige.Name(p.Vorname, p.Nachname)</text>),
        new("Rolle", p => @<text>@Anzeige.Rolle(p.Rolle)</text>),
    ];

    private static readonly IReadOnlyList<Spalte<OffeneEinladung>> EinladungsSpalten =
    [
        new("Mail-Adresse", e => @<text>@e.Mail</text>),
        new("Rolle", e => @<text>@Anzeige.Rolle(e.Rolle)</text>),
        new("Gültigkeit", e => @<text>gültig bis @Anzeige.Datum(e.GueltigBis)</text>),
    ];

    private static readonly IReadOnlyList<AuswahlOption> RollenOptionen =
    [
        new(nameof(OrgRolle.OrgAdmin), Anzeige.Rolle(OrgRolle.OrgAdmin)),
        new(nameof(OrgRolle.OrgUeberblick), Anzeige.Rolle(OrgRolle.OrgUeberblick)),
    ];

    private IReadOnlyList<Spalte<RichtlinieZeile>> RichtlinienSpalten =>
    [
        new("Nachweis", z => @<text>@Anzeige.Nachweis(z.Art)</text>),
        new("Pflicht", z => @<AutosaveAnkreuzfeld Label="Pflicht" Id="@($"richtlinie-pflicht-{RichtlinieFelder.JsonName(z.Art)}")"
                                                    Feldname="@RichtlinieFelder.Pflicht" Pfad="@OrganisationenApiClient.RichtliniePfad(OrgId, z.Art)"
                                                    Wert="@z.Pflicht" Version="@z.Version" NeuLaden="RichtlinieLadenAsync" />),
        new("Gültig (Monate)", z => @<AutosaveFeld Label="Gültig (Monate)" Id="@($"richtlinie-monate-{RichtlinieFelder.JsonName(z.Art)}")" Typ="number"
                                                   Feldname="@RichtlinieFelder.GueltigkeitMonate" Pfad="@OrganisationenApiClient.RichtliniePfad(OrgId, z.Art)"
                                                   Wert="@z.GueltigkeitMonate.ToString(System.Globalization.CultureInfo.InvariantCulture)" Version="@z.Version"
                                                   NeuLaden="RichtlinieLadenAsync" />),
    ];

    private List<RichtlinieZeile>? _richtlinie;
    private bool _richtlinieFehlt;
    private LoeschfristenAntwort? _loeschfristen;
    private bool _loeschfristenFehlen;
    private OrganisationAntwort? _organisation;
    private RollenAntwort? _rollen;
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _uebertraegt;
    private bool _eingeladen;
    private string? _mail;
    private OrgRolle? _rolle;
    private string? _mailFehler;
    private string? _rolleFehler;

    [Parameter] public Guid OrgId { get; set; }

    private bool RollenVergeben => Darf(Aktionsschluessel.OrgRollenVergeben);

    private bool Darf(string schluessel) => _organisation?.Erlaubt.Contains(schluessel) == true;

    protected override async Task OnParametersSetAsync()
    {
        _organisation = null;
        _rollen = null;
        _richtlinie = null;
        _richtlinieFehlt = false;
        _loeschfristen = null;
        _loeschfristenFehlen = false;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _eingeladen = false;
        try
        {
            _organisation = await Organisationen.LadenAsync(OrgId);
            _nichtVerfuegbar = _organisation is null;
            if (RollenVergeben)
            {
                await RollenLadenAsync();
            }

            if (Darf(Aktionsschluessel.NachweisRichtlinieVerwalten))
            {
                await RichtlinieLadenAsync();
            }

            if (Darf(Aktionsschluessel.LoeschfristenVerwalten))
            {
                await LoeschfristenLadenAsync();
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (offline, 5xx) die Meldung statt „Wird geladen …“.
            _aktionFehler = true;
        }
    }

    /// <summary>Lädt die Richtlinie; ohne Antwort (403/404) zeigt die Card die Fehlermeldung statt „Wird geladen …“.</summary>
    private async Task RichtlinieLadenAsync()
    {
        _richtlinie = await Organisationen.RichtlinieLadenAsync(OrgId);
        _richtlinieFehlt = _richtlinie is null;
    }

    /// <summary>Lädt die Löschfristen; ohne Antwort (403/404) zeigt die Card die Fehlermeldung statt „Wird geladen …“.</summary>
    private async Task LoeschfristenLadenAsync()
    {
        _loeschfristen = await Organisationen.LoeschfristenLadenAsync(OrgId);
        _loeschfristenFehlen = _loeschfristen is null;
    }

    private async Task RollenLadenAsync()
    {
        _rollen = await Organisationen.RollenLadenAsync(OrgId);
        _nichtVerfuegbar = _rollen is null;
    }

    private async Task EinladenAsync()
    {
        _uebertraegt = true;
        _eingeladen = false;
        _aktionFehler = false;
        try
        {
            var ergebnis = await Organisationen.EinladenAsync(OrgId, _mail, _rolle);
            _mailFehler = ergebnis.MailFehler;
            _rolleFehler = ergebnis.RolleFehler;
            if (ergebnis.Id is not null)
            {
                _eingeladen = true;
                _mail = null;
                _rolle = null;
                await RollenLadenAsync();
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
        finally
        {
            _uebertraegt = false;
        }
    }
}
