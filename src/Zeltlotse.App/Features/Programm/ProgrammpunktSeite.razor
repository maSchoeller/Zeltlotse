@page "/freizeiten/{FreizeitId:guid}/programm/{PunktId:guid}"
@using Zeltlotse.Api.Contracts.Freizeiten
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Api.Contracts.Programm
@using Zeltlotse.Ui.Kontext
@using ApiMaterialliste = Zeltlotse.Api.Contracts.Programm.Materialliste
@inject FreizeitKontextDienst Kontext
@inject FreizeitenApiClient Freizeiten
@inject ProgrammApiClient ProgrammApi
@inject NavigationManager Navigation
@* Programmpunkt (CAP-19, FR-34, FR-35, Story 3-1; EXPERIENCE.md → Fläche „Programmpunkt“) für Leitung und Team, erreicht über den Titel im
   Wochenraster. Dachzeile „Programm“, Überschrift „Programmpunkt“ und der Tag (Titel und Uhrzeit nur in den Feldern, nach dem Abschluss als Liste); „Übernommen: …“ mit „Ich übernehme“ bzw. „Abgeben“ (ein Tipp, nur
   für sich selbst). Card „Bearbeiten“ mit Titel und Uhrzeit als Autosave-Felder (AD-19; verschieben heißt Uhrzeit ändern). Löschen per
   Inline-Bestätigung, nicht bei den festen Mahlzeiten. In der Phase „gelaufen“ nur lesbar. Kontext, Raster oder Punkt nicht verfügbar →
   „Diese Seite ist nicht verfügbar.“ Story 3-2: Card „Material“ mit dem Material des Punkts (aus der Materialliste gefiltert; Bezeichnung und
   Menge als Autosave-Felder, Status per Segmente, „Ich bringe das mit“, Löschen), ohne Material „Noch kein Material.“, darunter das Formular
   „Material hinzufügen“ (Bezeichnung *, Menge). *@
<PageTitle>Programmpunkt – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else
{
    <Dachzeile>Programm</Dachzeile>
    @if (_punkt is null || _kontext is null)
    {
        <h1>Programmpunkt</h1>
        @if (_aktionFehler)
        {
            <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                <p>@AnmeldungAbschluss.FehlerText</p>
            </Meldung>
        }
        else
        {
            <Ladezustand />
        }
    }
    else
    {
        @* Titel und Uhrzeit stehen nur in den Feldern (Autosave); Überschrift und Tageszeile wiederholen sie nicht, damit nichts Veraltetes stehen bleibt. *@
        <h1>Programmpunkt</h1>
        <p>@Anzeige.TagLang(_punkt.Tag)</p>
        @if (_punkt.Mahlzeit is not null)
        {
            <p>Feste Mahlzeit: Titel und Uhrzeit lassen sich ändern, löschen lässt sie sich nicht.</p>
        }
        @if (Abgeschlossen)
        {
            <Meldung Titel="Hinweis">
                <p>@ProgrammTexte.AbgeschlossenText</p>
            </Meldung>
            <DetailsListe Eintraege="@([new DetailsEintrag("Titel", _punkt.Titel), new DetailsEintrag("Uhrzeit", _punkt.Beginn ?? "ohne Uhrzeit")])" />
        }
        @if (_meldung is not null)
        {
            <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                <p>@_meldung</p>
            </Meldung>
        }
        @if (ProgrammTexte.StatusWort(_punkt, _namen) is { } status)
        {
            <p><Status Wort="@status" Art="StatusArt.Erfolg" /></p>
        }
        @if (!Abgeschlossen && _punkt.UebernommenVon is null)
        {
            <p><Knopf Art="KnopfArt.Outline" Deaktiviert="@_uebertraegt" @onclick="@(() => UebergangAsync(uebernehmen: true))">Ich übernehme</Knopf></p>
        }
        else if (!Abgeschlossen && _punkt.Meins)
        {
            <p><Knopf Art="KnopfArt.Outline" Deaktiviert="@_uebertraegt" @onclick="@(() => UebergangAsync(uebernehmen: false))">Abgeben</Knopf></p>
        }

        @if (!Abgeschlossen)
        {
            <Card Titel="Bearbeiten">
                <AutosaveFeld Label="Titel" Id="programmpunkt-titel" Feldname="@ProgrammpunktFelder.Titel" Pfad="@Pfad" Wert="@_punkt.Titel"
                              Version="@_punkt.Version" Hinweis="@($"Höchstens {ProgrammpunktFelder.TitelMaximaleLaenge} Zeichen")" NeuLaden="NeuLadenAsync" />
                <AutosaveFeld Label="Uhrzeit" Id="programmpunkt-beginn" Typ="time" Feldname="@ProgrammpunktFelder.Beginn" Pfad="@Pfad"
                              Wert="@_punkt.Beginn" Version="@_punkt.Version" Hinweis="Ohne Uhrzeit steht der Programmpunkt am Ende des Tages."
                              NeuLaden="NeuLadenAsync" />
            </Card>
        }
        <Card Titel="Material" Id="material">
            @if (_materialFehlt)
            {
                <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
                    <p>@MaterialFehltText</p>
                </Meldung>
            }
            else
            {
                @foreach (var material in _material)
                {
                    <MaterialEintrag @key="material.Id" FreizeitId="FreizeitId" Material="material" Namen="_namen" Bearbeiten="true" NurLesen="Abgeschlossen"
                                     Geaendert="MaterialGeaendert" Geloescht="MaterialGeloescht" NeuLaden="MaterialNeuLadenAsync" />
                }
                @if (_material.Count == 0)
                {
                    <LeerZustand Satz="Noch kein Material." />
                }
                @if (!Abgeschlossen)
                {
                    <h3>Material hinzufügen</h3>
                    <Formular Absenden="MaterialAnlegenAsync">
                        <Feld Label="Bezeichnung *" Id="material-bezeichnung" Wert="@_bezeichnung" Fehler="@_bezeichnungFehler" autocomplete="off"
                              Hinweis="@($"Höchstens {MaterialFelder.BezeichnungMaximaleLaenge} Zeichen")" @oninput="@(e => _bezeichnung = e.Value?.ToString())" />
                        <Feld Label="Menge" Id="material-menge" Wert="@_menge" Fehler="@_mengeFehler" autocomplete="off" Hinweis="Freitext, z. B. 4 × 10 m"
                              @oninput="@(e => _menge = e.Value?.ToString())" />
                        <Knopf Typ="submit" Deaktiviert="@_uebertraegt">Material hinzufügen</Knopf>
                    </Formular>
                    <p>* Pflichtfeld</p>
                }
            }
        </Card>
        @if (!Abgeschlossen)
        {
            @if (_punkt.Mahlzeit is null)
            {
                <InlineBestaetigung AusloeserText="Programmpunkt löschen" AusloeserArt="KnopfArt.Outline" Satz="Diesen Programmpunkt löschen?"
                                    JaText="Ja, löschen" Bestaetigt="LoeschenAsync" />
            }
        }
        <p><a href="@ProgrammTexte.RasterZiel(FreizeitId, _punkt.Tag)">Zurück zum Programm</a></p>
    }
}

@code {
    private FreizeitKontext? _kontext;
    private Programmpunkt? _punkt;
    private IReadOnlyDictionary<Guid, string> _namen = new Dictionary<Guid, string>();
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _uebertraegt;
    private string? _meldung;
    private List<Material> _material = [];
    private bool _materialFehlt;
    private string? _bezeichnung;
    private string? _menge;
    private string? _bezeichnungFehler;
    private string? _mengeFehler;

    [Parameter] public Guid FreizeitId { get; set; }

    [Parameter] public Guid PunktId { get; set; }

    private bool Abgeschlossen => _kontext?.Phase == Phase.Gelaufen;

    private string Pfad => ProgrammApiClient.PunktPfad(FreizeitId, PunktId);

    protected override async Task OnParametersSetAsync()
    {
        _kontext = null;
        _punkt = null;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _meldung = null;
        try
        {
            var kontext = Kontext.LadenAsync(FreizeitId);
            var raster = ProgrammApi.LadenAsync(FreizeitId);
            var freizeit = Leise(Freizeiten.LadenAsync(FreizeitId));
            var personen = Leise(Freizeiten.PersonenlisteLadenAsync(FreizeitId));
            var material = Leise(ProgrammApi.MaterialLadenAsync(FreizeitId));
            await Task.WhenAll(kontext, raster, freizeit, personen, material);
            _punkt = raster.Result?.Punkte.FirstOrDefault(p => p.Id == PunktId);
            _materialFehlt = material.Result is null;
            _material = MaterialDesPunkts(material.Result);
            if (kontext.Result is null || _punkt is null)
            {
                _nichtVerfuegbar = true;
                return;
            }

            _kontext = kontext.Result;
            _namen = ProgrammTexte.Namen(freizeit.Result, personen.Result);
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _aktionFehler = true;
        }
    }

    /// <summary>„Neu laden“ beim Konflikt im Autosave: den Punkt mit Wert und Version neu holen.</summary>
    private async Task NeuLadenAsync()
    {
        try
        {
            _punkt = (await ProgrammApi.LadenAsync(FreizeitId))?.Punkte.FirstOrDefault(p => p.Id == PunktId) ?? _punkt;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
    }

    /// <summary>Scheitert die Materialliste (Fehler oder nicht verfügbar), zeigt die Card nur diese Meldung; der Rest der Seite bleibt.</summary>
    public const string MaterialFehltText = "Das Material lässt sich gerade nicht laden.";

    private List<Material> MaterialDesPunkts(ApiMaterialliste? liste) => [.. (liste?.Material ?? []).Where(m => m.ProgrammpunktId == PunktId)];

    private void MaterialGeaendert(Material material) =>
        _material = [.. _material.Select(m => m.Id == material.Id ? material : m)];

    private void MaterialGeloescht(Material material) => _material.RemoveAll(m => m.Id == material.Id);

    /// <summary>„Neu laden“ beim Konflikt am Material: das Material des Punkts neu holen.</summary>
    private async Task MaterialNeuLadenAsync()
    {
        try
        {
            _material = MaterialDesPunkts(await ProgrammApi.MaterialLadenAsync(FreizeitId));
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
    }

    /// <summary>„Material hinzufügen“: danach steht es mit Status „gebraucht“ in der Card, das Formular ist leer.</summary>
    private async Task MaterialAnlegenAsync()
    {
        if (_uebertraegt)
        {
            return;
        }

        _uebertraegt = true;
        (_bezeichnungFehler, _mengeFehler, _meldung) = (null, null, null);
        try
        {
            var aktion = await ProgrammApi.MaterialAnlegenAsync(FreizeitId, PunktId, new MaterialNeu(_bezeichnung, string.IsNullOrWhiteSpace(_menge) ? null : _menge));
            switch (aktion.Ergebnis)
            {
                case ProgrammAktionErgebnis.Erfolg:
                    _material.Add(aktion.Material!);
                    _material = [.. _material.OrderBy(m => m.Bezeichnung, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("de-DE"), true))];
                    (_bezeichnung, _menge) = (null, null);
                    break;
                case ProgrammAktionErgebnis.Abgeschlossen:
                    _meldung = ProgrammTexte.AbgeschlossenText;
                    break;
                default:
                    _bezeichnungFehler = aktion.Feldfehler.GetValueOrDefault(MaterialFelder.Bezeichnung);
                    _mengeFehler = aktion.Feldfehler.GetValueOrDefault(MaterialFelder.Menge);
                    if (_bezeichnungFehler is null && _mengeFehler is null)
                    {
                        _meldung = AnmeldungAbschluss.FehlerText;
                    }

                    break;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
        finally
        {
            _uebertraegt = false;
        }
    }

    private static async Task<T?> Leise<T>(Task<T?> abruf)
        where T : class
    {
        try
        {
            return await abruf;
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            return null;
        }
    }

    private async Task UebergangAsync(bool uebernehmen)
    {
        if (_uebertraegt)
        {
            return;
        }

        _uebertraegt = true;
        _meldung = null;
        try
        {
            var aktion = uebernehmen ? await ProgrammApi.UebernehmenAsync(FreizeitId, PunktId) : await ProgrammApi.AbgebenAsync(FreizeitId, PunktId);
            switch (aktion.Ergebnis)
            {
                case ProgrammAktionErgebnis.Erfolg:
                    _punkt = aktion.Punkt;
                    break;
                case ProgrammAktionErgebnis.Konflikt:
                    _meldung = ProgrammTexte.KonfliktText;
                    await NeuLadenAsync();
                    break;
                case ProgrammAktionErgebnis.Abgeschlossen:
                    _meldung = ProgrammTexte.AbgeschlossenText;
                    break;
                default:
                    _meldung = AnmeldungAbschluss.FehlerText;
                    break;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
        finally
        {
            _uebertraegt = false;
        }
    }

    private async Task LoeschenAsync()
    {
        _meldung = null;
        try
        {
            switch (await ProgrammApi.LoeschenAsync(FreizeitId, PunktId))
            {
                case ProgrammAktionErgebnis.Erfolg:
                    Navigation.NavigateTo(ProgrammTexte.RasterZiel(FreizeitId, _punkt!.Tag));
                    break;
                case ProgrammAktionErgebnis.Abgeschlossen:
                    _meldung = ProgrammTexte.AbgeschlossenText;
                    break;
                default:
                    _meldung = AnmeldungAbschluss.FehlerText;
                    break;
            }
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            _meldung = AnmeldungAbschluss.FehlerText;
        }
    }
}
