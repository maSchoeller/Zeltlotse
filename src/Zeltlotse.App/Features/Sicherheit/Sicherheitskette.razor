@page "/freizeiten/{FreizeitId:guid}/notfall"
@attribute [OfflineNutzbar]
@using Zeltlotse.Api.Contracts.Freizeiten
@using Zeltlotse.Api.Contracts.Gemeinsam
@using Zeltlotse.Api.Contracts.Personen
@using Zeltlotse.Ui.Kontext
@using ApiKette = Zeltlotse.Api.Contracts.Sicherheit.Sicherheitskette
@inject FreizeitKontextDienst Kontext
@inject FreizeitenApiClient Freizeiten
@inject SicherheitApiClient SicherheitApi
@inject OfflineSpeicher Speicher
@inject AppVerbindung Verbindung
@* Sicherheitskette (EXPERIENCE.md → Component Patterns „Sicherheitskette“, FR-28, FR-29, Story 2-8), in allen Phasen für Leitung und Team.
   Reihenfolge: Dachzeile „Notfall“ und Überschrift, ganz oben die Schnellsuche „Betroffene Person suchen“ (ein Treffer öffnet den
   Freizeitpass), ohne Einrichtung der Hinweis, Card „Was jetzt zu tun ist“ (ein Schritt je Zeile, nummeriert) und Card „Wen anrufen“ mit
   „Notruf 112“, der Leitung (Namen immer, Telefon, wenn eingerichtet) und der Ansprechperson am Heimatort (mit Telefon).
   Kontext, Freizeit, Personenliste und Kette laden parallel. Kontext, Freizeit oder Kette nicht verfügbar → „Diese Seite ist nicht
   verfügbar.“; scheitert nur die Personenliste, entfällt nur die Suche. Story 2-10: Vor „Wen anrufen“ zeigt die Card „Vorfall-Protokoll“
   den Weg dorthin (betroffene Person suchen, im Freizeitpass „Vorfall-Protokoll“). Story 2-11: unter „Wen anrufen“ der Knopf
   „Notfallordner drucken“, nur mit „freizeitpaesse-sehen“. Story 6-5: Offline (oder bei einem Netzfehler) liest die Seite Freizeit, Kette und
   Notfallkarte aus dem Offline-Speicher; die Suche findet dann die Personen der Notfallkarte und öffnet deren Notfallkarte, „Notfallordner drucken“
   ist ausgegraut. Ist nichts gespeichert: „Auf diesem Gerät nicht gespeichert.“ mit dem Verweis auf den ausgedruckten Notfallordner und 112. *@
<PageTitle>Sicherheitskette – Zeltlotse</PageTitle>

@if (_nichtVerfuegbar)
{
    <NichtVerfuegbar />
}
else
{
    <Dachzeile>Notfall</Dachzeile>
    <h1>Sicherheitskette</h1>

    @if (_nichtGespeichert)
    {
        <Meldung Titel="Hinweis">
            <p>@OfflineSpeicher.NichtGespeichertText</p>
            <p>Offline gilt der ausgedruckte Notfallordner.</p>
        </Meldung>
        <p><TelefonLink Nummer="112" Text="Notruf 112" /></p>
    }
    else if (_aktionFehler)
    {
        <Meldung Titel="Fehler" Art="MeldungArt.Fehler">
            <p>@AnmeldungAbschluss.FehlerText</p>
        </Meldung>
        <p><TelefonLink Nummer="112" Text="Notruf 112" /></p>
    }
    else if (_kette is null || _freizeit is null)
    {
        <Ladezustand />
    }
    else
    {
        @if (_offline)
        {
            @if (_karte is not null)
            {
                <Schnellsuche FreizeitId="FreizeitId" Label="Betroffene Person suchen" Id="betroffene-person" Notfallkarte="_karte" />
            }
        }
        else if (_personen is not null)
        {
            <Schnellsuche FreizeitId="FreizeitId" Label="Betroffene Person suchen" Id="betroffene-person" Personen="_personen" />
        }
        @if (!_kette.Eingerichtet)
        {
            <Meldung Titel="Hinweis">
                <p>Die Sicherheitskette ist noch nicht eingerichtet.</p>
            </Meldung>
        }
        @if (Schritte.Count > 0)
        {
            <Card Titel="Was jetzt zu tun ist">
                <ol>
                    @foreach (var schritt in Schritte)
                    {
                        <li>@schritt</li>
                    }
                </ol>
            </Card>
        }
        <Card Titel="Vorfall-Protokoll">
            @if (_offline)
            {
                <p>Betroffene Person oben suchen und in der Notfallkarte „Vorfall-Protokoll“ wählen. Ohne Verbindung warten die Einträge verschlüsselt auf dem Gerät und gehen an die Leitung, sobald wieder Empfang da ist.</p>
            }
            else
            {
                <p>Betroffene Person oben suchen und im Freizeitpass „Vorfall-Protokoll“ wählen. Jeder Eintrag ist sofort für die Leitung sichtbar.</p>
            }
        </Card>
        <Card Titel="Wen anrufen">
            <p><TelefonLink Nummer="112" Text="Notruf 112" /></p>
            <p>@LeitungZeile</p>
            @if (_kette.LeitungTelefon is { } leitung)
            {
                <p><TelefonLink Nummer="@leitung" Text="@($"Leitung anrufen: {leitung}")" /></p>
            }
            @if (_kette.HeimatName is not null || _kette.HeimatTelefon is not null)
            {
                <p>@(_kette.HeimatName is { } name ? $"Ansprechperson am Heimatort: {name}" : "Ansprechperson am Heimatort")</p>
                @if (_kette.HeimatTelefon is { } heimat)
                {
                    <p><TelefonLink Nummer="@heimat" Text="@($"Ansprechperson anrufen: {heimat}")" /></p>
                }
            }
        </Card>
        @* Story 2-11: Druckansicht des Notfallordners, die Rückfallebene ohne Netz (NFR-11). *@
        @if (_darfPaesse)
        {
            <p><Knopf Art="KnopfArt.Outline" Href="@($"freizeiten/{FreizeitId}/notfallordner")" Ansichtswechsel="true" Deaktiviert="@_offline">Notfallordner drucken</Knopf></p>
        }
    }
    <p><a href="@($"freizeiten/{FreizeitId}")">Zurück zur Freizeit</a></p>
}

@code {
    private FreizeitAntwort? _freizeit;
    private ApiKette? _kette;
    private List<PersonenlisteZeile>? _personen;
    private List<NotfallkartePerson>? _karte;
    private bool _offline;
    private bool _nichtGespeichert;
    private bool _nichtVerfuegbar;
    private bool _aktionFehler;
    private bool _darfPaesse;

    [Parameter] public Guid FreizeitId { get; set; }

    /// <summary>Die Schritte aus „Was jetzt zu tun ist“: eine Zeile je Schritt, leere Zeilen fallen weg.</summary>
    private List<string> Schritte =>
        [.. (_kette?.WasTun ?? "").Split('\n').Select(z => z.Trim()).Where(z => z.Length > 0)];

    private string LeitungZeile => _freizeit!.Leitung.Count == 0
        ? "Leitung"
        : $"Leitung: {string.Join(", ", _freizeit.Leitung.Select(l => Anzeige.Name(l.Vorname, l.Nachname)))}";

    protected override async Task OnParametersSetAsync()
    {
        _freizeit = null;
        _kette = null;
        _personen = null;
        _karte = null;
        _offline = false;
        _nichtGespeichert = false;
        _nichtVerfuegbar = false;
        _aktionFehler = false;
        _darfPaesse = false;
        if (Verbindung.Offline)
        {
            await AusDemSpeicherAsync();
            return;
        }

        try
        {
            var kontext = Kontext.LadenAsync(FreizeitId);
            var freizeit = Freizeiten.LadenAsync(FreizeitId);
            var kette = SicherheitApi.SicherheitsketteLadenAsync(FreizeitId);
            var personen = PersonenAsync();
            await Task.WhenAll(kontext, freizeit, kette, personen);
            if (kontext.Result is null || freizeit.Result is null || kette.Result is null)
            {
                _nichtVerfuegbar = true;
                return;
            }

            (_freizeit, _kette, _personen) = (freizeit.Result, kette.Result, personen.Result);
            _darfPaesse = FreizeitKontextDienst.Darf(kontext.Result, Aktionsschluessel.FreizeitpaesseSehen);
        }
        catch (Exception fehler) when (OfflineAbgleich.IstNetzfehler(fehler))
        {
            // Story 6-5: kein Netz, dann eben der Stand auf dem Gerät.
            await AusDemSpeicherAsync();
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            // 401 führt der Sitzungs-Handler zur Anmeldung; sonst (5xx) die Meldung statt „Wird geladen …“.
            _aktionFehler = true;
        }
    }

    /// <summary>Story 6-5: Freizeit, Kette und Notfallkarte aus dem Offline-Speicher; ohne Freizeit oder Kette „Auf diesem Gerät nicht gespeichert.“.</summary>
    private async Task AusDemSpeicherAsync()
    {
        _offline = true;
        var freizeit = await Speicher.FreizeitLesenAsync(FreizeitId);
        var kette = freizeit is null ? null : await Speicher.SicherheitsketteLesenAsync(FreizeitId);
        if (freizeit is null || kette is null)
        {
            _nichtGespeichert = true;
            return;
        }

        (_freizeit, _kette) = (freizeit.Freizeit, kette);
        _karte = await Speicher.NotfallkarteLesenAsync(FreizeitId);
        _darfPaesse = FreizeitKontextDienst.Darf(freizeit.Kontext, Aktionsschluessel.FreizeitpaesseSehen);
    }

    /// <summary>Die Personenliste für die Suche; scheitert der Abruf, entfällt nur die Suche.</summary>
    private async Task<List<PersonenlisteZeile>?> PersonenAsync()
    {
        try
        {
            return await Freizeiten.PersonenlisteLadenAsync(FreizeitId);
        }
        catch (Exception fehler) when (AnmeldungAbschluss.IstAktionsfehler(fehler))
        {
            return null;
        }
    }
}
