@* Story 6-5: Ob die Seite der Route offline nutzbar ist ([OfflineNutzbar]), geht als kaskadierter Wert an das Layout. *@
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <CascadingValue Name="@OfflineNutzbarAttribute.Kaskade" Value="@OfflineNutzbarAttribute.Gilt(routeData.PageType)">
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        </CascadingValue>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <PageTitle>Nicht verfügbar – Zeltlotse</PageTitle>
            <h1>Diese Seite ist nicht verfügbar.</h1>
            <p><a href="./">Zur Startseite</a></p>
        </LayoutView>
    </NotFound>
</Router>
