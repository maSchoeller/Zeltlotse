@attribute [NurInteraktiv]
@implements IDisposable
@inject AutosaveDienst Dienst
@* Autosave-Baustein (AD-19, AD-29): speichert beim Verlassen des Feldes, nur wenn sich der Wert geändert hat.
   Gespeichert → „Gespeichert · Rückgängig“; Rückgängig ist ein erneuter PATCH mit dem vorigen Wert. 409 →
   „Inzwischen geändert – neu laden?“; Netzfehler oder 5xx → „Nicht gespeichert.“ mit „Erneut versuchen“, der Wert
   bleibt stehen. Zusammengesetzt nur aus Bausteinen von Ui.Komponenten, ohne eigene Klassen. *@
<Feld Label="@Label" Id="@Id" Name="@Feldname" Typ="@Typ" Hinweis="@(_zustand == SpeicherZustand.Keiner ? Hinweis : null)"
      Wert="@_eingabe" @onfocus="Fokus" @oninput="Eingabe" @onblur="VerlassenAsync">
    <UnterDemFeld>
        <SpeicherHinweis Zustand="_zustand" MitRueckgaengig="_mitRueckgaengig" Uebertraegt="_uebertraegt"
                         Rueckgaengig="RueckgaengigAsync" NeuLaden="NeuLaden" ErneutVersuchen="ErneutVersuchenAsync" />
    </UnterDemFeld>
</Feld>

@code {
    private string? _gespeichert;
    private string? _eingabe;
    private uint _version;
    private string? _vorher;
    private SpeicherZustand _zustand;
    private bool _mitRueckgaengig;
    private bool _uebertraegt;
    private AutosaveAnfrage? _letzteAnfrage;
    private bool _letzteWarRueckgaengig;
    private bool _nachspeichern;
    private (string? Wert, uint Version)? _letzteParameter;

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>JSON-Name des Felds aus <c>Zeltlotse.Api.Contracts</c>.</summary>
    [Parameter, EditorRequired] public string Feldname { get; set; } = "";

    /// <summary>Pfad der Ressource für den PATCH.</summary>
    [Parameter, EditorRequired] public string Pfad { get; set; } = "";

    /// <summary>Wert beim Laden.</summary>
    [Parameter] public string? Wert { get; set; }

    /// <summary>Version der Ressource beim Laden.</summary>
    [Parameter] public uint Version { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter] public string Typ { get; set; } = "text";

    [Parameter] public string? Hinweis { get; set; }

    /// <summary>„Neu laden“ beim Konflikt: die Seite lädt die Ressource neu und übergibt Wert und Version.</summary>
    [Parameter] public EventCallback NeuLaden { get; set; }

    protected override void OnInitialized() => Dienst.FeldAktiv += AnderesFeldAktiv;

    protected override void OnParametersSet()
    {
        // Neue Werte von außen (erstes Laden oder nach „Neu laden“) übernehmen; eigene Speicherstände bleiben sonst.
        if (_letzteParameter != (Wert, Version))
        {
            _letzteParameter = (Wert, Version);
            _gespeichert = Wert;
            _eingabe = Wert;
            _version = Version;
            _zustand = SpeicherZustand.Keiner;
        }
    }

    private void Fokus() => Dienst.Aktivieren(this);

    private void Eingabe(ChangeEventArgs e) => _eingabe = e.Value?.ToString();

    private Task VerlassenAsync()
    {
        if (_uebertraegt)
        {
            // Während einer Übertragung geändert und verlassen: nach der Übertragung speichern.
            _nachspeichern = true;
            return Task.CompletedTask;
        }

        return Geaendert ? SendenAsync(Aktuelle(), rueckgaengig: false) : Task.CompletedTask;
    }

    private bool Geaendert => !string.Equals(_eingabe ?? "", _gespeichert ?? "", StringComparison.Ordinal);

    private AutosaveAnfrage Aktuelle() => new(Pfad, Feldname, _version, _gespeichert, _eingabe);

    private Task RueckgaengigAsync() =>
        SendenAsync(new AutosaveAnfrage(Pfad, Feldname, _version, _gespeichert, _vorher), rueckgaengig: true);

    // Ein normaler Speichervorgang wird mit der aktuellen Eingabe wiederholt, ein Rückgängig unverändert.
    private Task ErneutVersuchenAsync() =>
        _letzteWarRueckgaengig && _letzteAnfrage is not null
            ? SendenAsync(_letzteAnfrage, rueckgaengig: true)
            : SendenAsync(Aktuelle(), rueckgaengig: false);

    private async Task SendenAsync(AutosaveAnfrage anfrage, bool rueckgaengig)
    {
        _letzteAnfrage = anfrage;
        _letzteWarRueckgaengig = rueckgaengig;
        _nachspeichern = false;
        var eingabeBeimSenden = _eingabe;
        _uebertraegt = true;
        Dienst.Aktivieren(this);
        StateHasChanged();

        AutosaveErgebnis ergebnis;
        try
        {
            ergebnis = await Dienst.SpeichernAsync(anfrage);
        }
#pragma warning disable CA1031 // Jeder Fehler beim Speichern zeigt „Nicht gespeichert.“, statt die Fehlergrenze auszulösen.
        catch (Exception)
#pragma warning restore CA1031
        {
            ergebnis = new AutosaveErgebnis.Gescheitert();
        }
        finally
        {
            _uebertraegt = false;
        }

        switch (ergebnis)
        {
            case AutosaveErgebnis.Gespeichert gespeichert:
                _vorher = anfrage.AlterWert;
                _version = gespeichert.Version;
                _gespeichert = gespeichert.Wert;
                // Nur übernehmen, wenn währenddessen nichts Neues eingegeben wurde.
                if (string.Equals(_eingabe, eingabeBeimSenden, StringComparison.Ordinal))
                {
                    _eingabe = gespeichert.Wert;
                }

                _zustand = SpeicherZustand.Gespeichert;
                _mitRueckgaengig = !rueckgaengig;
                if (_nachspeichern && Geaendert)
                {
                    await SendenAsync(Aktuelle(), rueckgaengig: false);
                }

                break;
            case AutosaveErgebnis.Konflikt:
                _zustand = SpeicherZustand.Konflikt;
                break;
            default:
                _zustand = SpeicherZustand.Gescheitert;
                break;
        }

        _nachspeichern = false;
    }

    // Nur „Gespeichert“ verschwindet; Konflikt und „Nicht gespeichert.“ bleiben, solange die Ursache besteht.
    private void AnderesFeldAktiv(object feld)
    {
        if (ReferenceEquals(feld, this) || _uebertraegt || _zustand != SpeicherZustand.Gespeichert)
        {
            return;
        }

        _zustand = SpeicherZustand.Keiner;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Dienst.FeldAktiv -= AnderesFeldAktiv;
}
