@attribute [NurInteraktiv]
@using Microsoft.AspNetCore.Components.Forms
@* Datei-Feld (EXPERIENCE.md → Component Patterns „Datei hochladen“, AD-15): Label sichtbar darüber, auf dem Handy direkt Foto
   aufnehmen oder Datei wählen. Erlaubt sind Fotos (JPEG, PNG, WebP) und PDF; geprüft wird am Inhalt auf dem Server. Ein Fehler
   „Fehler: …“ setzt aria-invalid und aria-describedby. Die gewählte Datei geht an DateiGewaehlt; hochgeladen wird erst durch die Seite. *@
<div class="elkw-field">
    <label for="@KennungFeld">@Label</label>
    <InputFile id="@KennungFeld" accept="@Erlaubt" disabled="@Deaktiviert" OnChange="GewaehltAsync"
               aria-invalid="@(Fehler is null ? null : "true")" aria-describedby="@Beschrieben" />
    @if (Hinweis is not null)
    {
        <span class="elkw-hint" id="@HinweisId">@Hinweis</span>
    }
    @if (Fehler is not null)
    {
        <span class="elkw-field-error" id="@FehlerId">Fehler: @Fehler</span>
    }
</div>

@code {
    /// <summary>Die erlaubten Typen im accept-Attribut: JPEG, PNG, WebP und PDF.</summary>
    public const string Erlaubt = "image/jpeg,image/png,image/webp,application/pdf";

    private readonly string _vorgabeId = Kennungen.Neu("datei");

    [Parameter] public string Label { get; set; } = "Foto aufnehmen oder Datei wählen";

    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Hinweis { get; set; }

    /// <summary>Fehlertext ohne Präfix, z. B. „Datei fehlt.“; angezeigt als „Fehler: Datei fehlt.“.</summary>
    [Parameter] public string? Fehler { get; set; }

    [Parameter] public bool Deaktiviert { get; set; }

    /// <summary>Die gewählte Datei (oder <c>null</c>, wenn die Auswahl leer ist).</summary>
    [Parameter] public EventCallback<IBrowserFile?> DateiGewaehlt { get; set; }

    private string KennungFeld => Id ?? _vorgabeId;

    private string HinweisId => KennungFeld + "-hinweis";

    private string FehlerId => KennungFeld + "-fehler";

    private string? Beschrieben
    {
        get
        {
            var text = string.Join(' ', new[] { Hinweis is null ? null : HinweisId, Fehler is null ? null : FehlerId }.Where(t => t is not null));
            return text.Length == 0 ? null : text;
        }
    }

    private Task GewaehltAsync(InputFileChangeEventArgs e) =>
        DateiGewaehlt.InvokeAsync(e.FileCount > 0 ? e.File : null);
}
