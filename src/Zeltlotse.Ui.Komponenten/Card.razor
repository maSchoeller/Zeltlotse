@* Card der Bibliothek (DESIGN.md): weiße Fläche mit Titel und Inhalt; optional mit einer Kennung als Sprungziel für Links. Story 3-2: optional
   eine Dachzeile über dem Titel und der Titel als Link (z. B. Tag und Uhrzeit eines Programmpunkts, Link zur Detailseite). Story 4-2: der Titel
   wahlweise als Überschrift der Ebene 3. *@
<section class="elkw-card" id="@Id" aria-labelledby="@(Titel is null ? null : _titelId)">
    <div class="elkw-card__body">
        @if (Titel is not null)
        {
            @if (Dachzeile is not null)
            {
                <p class="elkw-kicker">@Dachzeile</p>
            }
            @if (Ebene == 3 && TitelHref is not null)
            {
                <h3 class="elkw-card__title" id="@_titelId"><a href="@TitelHref">@Titel</a></h3>
            }
            else if (Ebene == 3)
            {
                <h3 class="elkw-card__title" id="@_titelId">@Titel</h3>
            }
            else if (TitelHref is not null)
            {
                <h2 class="elkw-card__title" id="@_titelId"><a href="@TitelHref">@Titel</a></h2>
            }
            else
            {
                <h2 class="elkw-card__title" id="@_titelId">@Titel</h2>
            }
        }
        @ChildContent
    </div>
</section>

@code {
    private readonly string _titelId = Kennungen.Neu("card");

    [Parameter] public string? Titel { get; set; }

    /// <summary>Story 3-2: Dachzeile über dem Titel, z. B. „Di 03.08. · 14:30“; nur mit Titel.</summary>
    [Parameter] public string? Dachzeile { get; set; }

    /// <summary>Story 3-2: Ziel des Titels; ohne Angabe ist der Titel nur Text.</summary>
    [Parameter] public string? TitelHref { get; set; }

    /// <summary>Kennung der Card (<c>id</c>), etwa als Anker eines Links auf derselben Seite; ohne Angabe keine.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Story 4-2: Überschriftenebene des Titels, 2 (Vorgabe) oder 3, z. B. für Cards unter einer Tagesüberschrift.</summary>
    [Parameter] public int Ebene { get; set; } = 2;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
