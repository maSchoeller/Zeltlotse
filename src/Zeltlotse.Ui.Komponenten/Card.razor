@* Card der Bibliothek (DESIGN.md): weiße Fläche mit Titel und Inhalt. *@
<section class="elkw-card" aria-labelledby="@(Titel is null ? null : _titelId)">
    <div class="elkw-card__body">
        @if (Titel is not null)
        {
            <h2 class="elkw-card__title" id="@_titelId">@Titel</h2>
        }
        @ChildContent
    </div>
</section>

@code {
    private readonly string _titelId = Kennungen.Neu("card");

    [Parameter] public string? Titel { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
