@page "/gast/{Token}"
@layout OhneRahmenLayout
@using Zeltlotse.Ui.Api
@using Zeltlotse.Ui.Texte
@inject FreizeitenApiClient Freizeiten
@inject NavigationManager Navigation
@inject TimeProvider Uhr
@* Story 2-5: je Anmeldung „Einsicht bis TT.MM.JJJJ“ bzw. „Einsicht beendet am TT.MM.JJJJ“ (bis wann die Freizeit den Pass sieht). *@
@* Gast-Link aus der Eingangsmail (AD-11, FR-17, FR-20, FR-21): die Anmeldungen der Gast-Familie mit Vorname, Freizeit, Zeitraum, Status
   und, solange nicht abgesagt, dem Weg zum Freizeitpass (Story 2-4) und dem Kontakt der Leitung für Absagen (Story 2-3),
   wie lange der Gast-Link gilt, und das Angebot „Konto aus diesen Daten erstellen?“. Nur eine Ansicht, statisch gerendert, ohne
   Skript. Ungültig, abgelaufen oder übernommen: Status 404 mit „Dieser Link ist nicht mehr gültig.“; Zugriffsbegrenzung: Status 429.
   Suchmaschinen nehmen die Seite nicht auf (noindex). *@

@if (_zuViele)
{
    <ZuVieleAufrufe />
}
else if (_ansicht is not null)
{
    <PageTitle>Anmeldungen – Zeltlotse</PageTitle>
    <HeadContent><meta name="robots" content="noindex" /></HeadContent>
    <OeffentlicherRahmen>
        <h1>Anmeldungen</h1>
        @if (_ansicht.Anmeldungen.Count == 0)
        {
            <p>Noch keine Anmeldung über diesen Gast-Link.</p>
        }
        @foreach (var anmeldung in _ansicht.Anmeldungen)
        {
            <Card Titel="@anmeldung.Vorname">
                <p>@anmeldung.FreizeitName</p>
                <p>@Anzeige.ZeitraumLang(anmeldung.ErsterTag, anmeldung.LetzterTag)</p>
                <p><Status Wort="@Anzeige.Status(anmeldung.Status)" Art="@Anzeige.AnmeldungStatusArt(anmeldung.Status)" /></p>
                @if (anmeldung.EinsichtBis is { } einsichtBis)
                {
                    <p>@Anzeige.Einsicht(einsichtBis, Uhr.GetUtcNow())</p>
                }
                @if (anmeldung.Status != Zeltlotse.Api.Contracts.Freizeiten.AnmeldungStatus.Abgesagt)
                {
                    @if (anmeldung.AnmeldungId != Guid.Empty && (anmeldung.Fragen?.Count ?? 0) > 0)
                    {
                        <p><Knopf Href="@($"/gast/{Token}/freizeitpass/{anmeldung.AnmeldungId}")" Art="KnopfArt.Outline" Ansichtswechsel="true">Freizeitpass für @anmeldung.Vorname</Knopf></p>
                    }
                    @if (anmeldung.AnmeldungId != Guid.Empty)
                    {
                        @* Story 2-7: Infobrief, Packliste und Notfallnummern der Freizeit ohne Konto (FR-68). *@
                        <p><a href="@($"/gast/{Token}/elterninfo/{anmeldung.AnmeldungId}")">Elterninfo</a></p>
                    }
                    <AbsageKontakt Mail="@anmeldung.KontaktMail" Telefon="@anmeldung.KontaktTelefon" />
                }
            </Card>
        }
        <p>Gast-Link gilt bis @Anzeige.BisEinschliesslich(_ansicht.GueltigBis).</p>

        <Card Titel="Konto aus diesen Daten erstellen?">
            <p>Mit einem Konto stehen die Angaben bei der nächsten Anmeldung bereit, und der Stand jeder Anmeldung steht in der Familienübersicht. Danach gilt dieser Gast-Link nicht mehr.</p>
            <p><Knopf Href="@($"/app/gast/{Token}/konto")" Ansichtswechsel="true">Konto erstellen</Knopf></p>
        </Card>
    </OeffentlicherRahmen>
}

@code {
    private Zeltlotse.Api.Contracts.Freizeiten.GastLinkAnsicht? _ansicht;
    private bool _zuViele;

    [Parameter] public string Token { get; set; } = "";

    [CascadingParameter] public HttpContext? HttpKontext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ansicht = await Freizeiten.GastLinkLadenAsync(Token);
        }
        catch (Exception fehler) when (ZuVieleAufrufe.IstZugriffsbegrenzt(fehler))
        {
            _zuViele = true;
            ZuVieleAufrufe.Status429(HttpKontext);
            return;
        }

        if (_ansicht is null)
        {
            // Status 404 mit „Dieser Link ist nicht mehr gültig.“ (NotFoundPage des Routers, markiert als Gast-Link).
            GastLinkUngueltig.Markieren(HttpKontext);
            Navigation.NotFound();
        }
    }
}
