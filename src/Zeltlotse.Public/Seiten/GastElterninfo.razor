@page "/gast/{Token}/elterninfo/{AnmeldungId:guid}"
@layout OhneRahmenLayout
@using Zeltlotse.Ui.Api
@using Zeltlotse.Ui.Texte
@inject FreizeitenApiClient Freizeiten
@inject NavigationManager Navigation
@* Elterninfo über den Gast-Link (AD-11, CAP-10, FR-68, Story 2-7): zu einer Anmeldung der Gast-Familie die Dokumente der Freizeit mit
   Sichtbarkeit „Eltern und Teilnehmende“, je als Link auf die Datei (Download über den Gast-Link). Dachzeile mit dem Namen der Freizeit,
   Zurück-Link zu den Anmeldungen. Nur eine Ansicht, statisch gerendert, ohne Skript. Ungültiger Gast-Link oder fremde Anmeldung:
   Status 404 mit „Dieser Link ist nicht mehr gültig.“; Zugriffsbegrenzung: Status 429. noindex. *@

@if (_zuViele)
{
    <ZuVieleAufrufe />
}
else if (_info is not null)
{
    <PageTitle>Elterninfo – Zeltlotse</PageTitle>
    <HeadContent><meta name="robots" content="noindex" /></HeadContent>
    <OeffentlicherRahmen>
        <Dachzeile>@_info.FreizeitName</Dachzeile>
        <h1>Elterninfo</h1>
        @if (_info.Dokumente.Count == 0)
        {
            <p>Noch keine Elterninfo.</p>
        }
        else
        {
            <Card Titel="Dokumente der Freizeit">
                <ul>
                    @foreach (var dokument in _info.Dokumente)
                    {
                        <li><a href="@($"{FreizeitenApiClient.GastElterninfoPfad(Token, AnmeldungId)}/{dokument.Id}")">@Anzeige.Dokument(dokument.Titel, dokument.Dateiart)</a></li>
                    }
                </ul>
            </Card>
        }
        <p><a href="@($"/gast/{Token}")">Zurück zu den Anmeldungen</a></p>
    </OeffentlicherRahmen>
}

@code {
    private Zeltlotse.Api.Contracts.Freizeiten.Elterninfo? _info;
    private bool _zuViele;

    [Parameter] public string Token { get; set; } = "";

    [Parameter] public Guid AnmeldungId { get; set; }

    [CascadingParameter] public HttpContext? HttpKontext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _info = await Freizeiten.GastElterninfoLadenAsync(Token, AnmeldungId);
        }
        catch (Exception fehler) when (ZuVieleAufrufe.IstZugriffsbegrenzt(fehler))
        {
            _zuViele = true;
            ZuVieleAufrufe.Status429(HttpKontext);
            return;
        }

        if (_info is null)
        {
            // Status 404 mit „Dieser Link ist nicht mehr gültig.“ (NotFoundPage des Routers, markiert als Gast-Link).
            GastLinkUngueltig.Markieren(HttpKontext);
            Navigation.NotFound();
        }
    }
}
